/* pages/home/index.wxss */
.home-container {
  min-height: 100vh;
  background: var(--bg-canvas);
  padding-bottom: 80rpx;
}

/* ============ Hero ============ */
.home-hero {
  position: relative;
  margin: var(--space-lg) var(--space-lg) var(--space-2xl);
  height: 460rpx;
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.hero-photo {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 70% 100% at 75% 30%, rgba(232, 145, 109, 0.55) 0%, transparent 70%),
    linear-gradient(180deg, #2C6378 0%, #1E5266 55%, #0F3848 100%);
  overflow: hidden;
}

/* 太阳 · 呼吸脉动 + 光晕扩散 */
.hero-sun {
  position: absolute;
  top: 80rpx;
  right: 130rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #F4C29B 0%, #E8916D 60%, #C76F4E 100%);
  box-shadow:
    0 0 80rpx rgba(232, 145, 109, 0.45),
    0 0 160rpx rgba(232, 145, 109, 0.25);
  animation: sun-pulse 4.5s ease-in-out infinite;
}

@keyframes sun-pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow:
      0 0 80rpx rgba(232, 145, 109, 0.45),
      0 0 160rpx rgba(232, 145, 109, 0.25);
  }
  50% {
    transform: scale(1.06);
    box-shadow:
      0 0 100rpx rgba(232, 145, 109, 0.6),
      0 0 220rpx rgba(232, 145, 109, 0.35);
  }
}

/* 海平面波浪 · 横向漂移 */
.hero-wave {
  position: absolute;
  left: -10%;
  right: -10%;
  bottom: 0;
  height: 180rpx;
  background:
    radial-gradient(ellipse 80rpx 60rpx at 20% 100%, rgba(255,255,255,0.22) 0%, transparent 70%),
    radial-gradient(ellipse 120rpx 80rpx at 50% 100%, rgba(255,255,255,0.15) 0%, transparent 70%),
    radial-gradient(ellipse 100rpx 70rpx at 80% 100%, rgba(255,255,255,0.18) 0%, transparent 70%),
    linear-gradient(180deg, transparent 0%, rgba(15, 56, 72, 0.55) 100%);
  animation: wave-drift 7s ease-in-out infinite;
}

@keyframes wave-drift {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(40rpx); }
}

/* 飘云 · 从右向左缓慢漂过 */
.hero-cloud {
  position: absolute;
  height: 40rpx;
  border-radius: 50rpx;
  background: rgba(255, 255, 255, 0.18);
  filter: blur(6rpx);
}

.cloud-1 {
  top: 60rpx;
  left: 40%;
  width: 220rpx;
  animation: cloud-drift-1 22s linear infinite;
}

.cloud-2 {
  top: 140rpx;
  left: 60%;
  width: 160rpx;
  height: 28rpx;
  background: rgba(255, 255, 255, 0.12);
  animation: cloud-drift-2 28s linear infinite;
  animation-delay: -10s;
}

@keyframes cloud-drift-1 {
  0%   { transform: translateX(0); opacity: 0; }
  10%  { opacity: 1; }
  90%  { opacity: 1; }
  100% { transform: translateX(-140%); opacity: 0; }
}

@keyframes cloud-drift-2 {
  0%   { transform: translateX(0); opacity: 0; }
  15%  { opacity: 0.9; }
  85%  { opacity: 0.9; }
  100% { transform: translateX(-160%); opacity: 0; }
}

.hero-tint {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(15, 56, 72, 0.55) 100%);
}

.hero-meta {
  position: absolute;
  left: var(--space-xl);
  right: var(--space-xl);
  bottom: var(--space-xl);
  color: var(--text-white);
  z-index: 2;
}

.hero-eyebrow-line {
  font-size: var(--font-xs);
  letter-spacing: 6rpx;
  opacity: 0.85;
  font-weight: 500;
  margin-bottom: var(--space-sm);
}

.hero-headline {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.15;
  margin-bottom: 10rpx;
}

.hero-sub {
  font-size: var(--font-sm);
  opacity: 0.85;
  letter-spacing: 1rpx;
}

/* ============ Section Head ============ */
.section-head {
  padding: var(--space-lg) var(--space-xl) var(--space-md);
}

.section-eyebrow {
  font-size: var(--font-xs);
  letter-spacing: 4rpx;
  color: var(--text-tertiary);
  font-weight: 500;
  margin-bottom: 6rpx;
}

.section-title {
  font-size: var(--font-2xl);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

/* ============ Bento 2×2 类目 ============ */
.home-bento {
  padding: 0 var(--space-lg);
}

.home-cat {
  position: relative;
  width: calc((100% - var(--space-lg)) / 2);
  min-height: 290rpx;
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  border-radius: var(--radius-xl);
  overflow: hidden;
  transition: transform 250ms var(--ease-out), box-shadow 250ms var(--ease-out);
  box-shadow: 0 4rpx 16rpx rgba(94, 72, 50, 0.05);
}

.home-cat:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(94, 72, 50, 0.08);
}

/* 右上主题装饰 SVG · 缓慢漂浮+轻微旋转 */
.cat-deco {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  pointer-events: none;
  animation: deco-float 9s ease-in-out infinite;
}

@keyframes deco-float {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  33%      { transform: translate(-6rpx, 4rpx) rotate(-3deg); }
  66%      { transform: translate(4rpx, -6rpx) rotate(3deg); }
}

/* 底部波浪光带 · 横向漂移 */
.cat-wave {
  position: absolute;
  left: -20%;
  right: -20%;
  bottom: -10rpx;
  height: 80rpx;
  pointer-events: none;
  background:
    radial-gradient(ellipse 80rpx 40rpx at 20% 80%, currentColor 0%, transparent 70%),
    radial-gradient(ellipse 120rpx 50rpx at 50% 85%, currentColor 0%, transparent 70%),
    radial-gradient(ellipse 90rpx 40rpx at 80% 80%, currentColor 0%, transparent 70%);
  opacity: 0.18;
  animation: wave-slide 8s ease-in-out infinite;
}

@keyframes wave-slide {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(40rpx); }
}

/* 角落光斑 · 双点错位脉动 */
.cat-spark {
  position: absolute;
  border-radius: 50%;
  background: currentColor;
  pointer-events: none;
  filter: blur(1rpx);
}

.spark-a {
  left: 28rpx;
  bottom: 110rpx;
  width: 10rpx;
  height: 10rpx;
  opacity: 0.55;
  animation: spark-pulse-a 3.2s ease-in-out infinite;
}

.spark-b {
  right: 100rpx;
  top: 40rpx;
  width: 6rpx;
  height: 6rpx;
  opacity: 0.6;
  animation: spark-pulse-b 4.5s ease-in-out infinite;
}

@keyframes spark-pulse-a {
  0%, 100% { opacity: 0.2; transform: scale(0.7); }
  35%      { opacity: 0.8; transform: scale(1.3); }
  70%      { opacity: 0.4; transform: scale(0.9); }
}

@keyframes spark-pulse-b {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50%      { opacity: 0.85; transform: scale(1.4); }
}

.home-cat-spot {
  background: var(--cat-spot-soft);
  color: var(--cat-spot);
}
.home-cat-food {
  background: var(--cat-food-soft);
  color: var(--cat-food);
}
.home-cat-route {
  background: var(--cat-route-soft);
  color: var(--cat-route);
}
.home-cat-info {
  background: var(--cat-info-soft);
  color: var(--cat-info);
}

/* 错相位 · 让 4 张卡的动画各自独立呼吸 */
.home-cat:nth-child(1) .cat-deco   { animation-delay: 0s; }
.home-cat:nth-child(2) .cat-deco   { animation-delay: -2.2s; }
.home-cat:nth-child(3) .cat-deco   { animation-delay: -4.5s; }
.home-cat:nth-child(4) .cat-deco   { animation-delay: -6.7s; }

.home-cat:nth-child(1) .cat-wave   { animation-delay: 0s; }
.home-cat:nth-child(2) .cat-wave   { animation-delay: -2s; }
.home-cat:nth-child(3) .cat-wave   { animation-delay: -4s; }
.home-cat:nth-child(4) .cat-wave   { animation-delay: -6s; }

.home-cat:nth-child(1) .spark-a    { animation-delay: 0s; }
.home-cat:nth-child(2) .spark-a    { animation-delay: -0.8s; }
.home-cat:nth-child(3) .spark-a    { animation-delay: -1.6s; }
.home-cat:nth-child(4) .spark-a    { animation-delay: -2.4s; }

.home-cat:nth-child(1) .spark-b    { animation-delay: -0.5s; }
.home-cat:nth-child(2) .spark-b    { animation-delay: -1.3s; }
.home-cat:nth-child(3) .spark-b    { animation-delay: -2.8s; }
.home-cat:nth-child(4) .spark-b    { animation-delay: -3.6s; }

/* 图标 · 浮动 */
.cat-icon {
  position: relative;
  z-index: 2;
  width: 76rpx;
  height: 76rpx;
  filter: drop-shadow(0 3rpx 8rpx rgba(0, 0, 0, 0.12));
  animation: icon-float 5s ease-in-out infinite;
}

.home-cat:nth-child(2) .cat-icon { animation-delay: -1.2s; }
.home-cat:nth-child(3) .cat-icon { animation-delay: -2.4s; }
.home-cat:nth-child(4) .cat-icon { animation-delay: -3.6s; }

@keyframes icon-float {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50%      { transform: translateY(-8rpx) rotate(-3deg); }
}

.cat-meta {
  position: relative;
  z-index: 2;
  margin-top: var(--space-md);
}

.cat-meta {
  margin-top: var(--space-md);
}

.cat-name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  margin-bottom: 4rpx;
}

.cat-desc {
  font-size: var(--font-xs);
  opacity: 0.78;
  letter-spacing: 0.5rpx;
}

.cat-arrow {
  position: absolute;
  right: var(--space-lg);
  bottom: var(--space-lg);
  width: 36rpx;
  height: 36rpx;
  opacity: 0.85;
  z-index: 2;
  animation: arrow-nudge 2.6s ease-in-out infinite;
}

@keyframes arrow-nudge {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(6rpx); }
}

.home-cat:nth-child(2) .cat-arrow { animation-delay: -0.6s; }
.home-cat:nth-child(3) .cat-arrow { animation-delay: -1.2s; }
.home-cat:nth-child(4) .cat-arrow { animation-delay: -1.8s; }

.cat-arrow image {
  width: 100%;
  height: 100%;
}

/* ============ 民宿入口大卡 ============ */
.home-hostel-card {
  position: relative;
  margin: var(--space-2xl) var(--space-lg) 0;
  min-height: 320rpx;
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
}

.hostel-card-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 100% at 80% 50%, rgba(232, 145, 109, 0.35) 0%, transparent 70%),
    linear-gradient(135deg, #1E5266 0%, #0F3848 100%);
  animation: hostel-glow 6s ease-in-out infinite;
}

@keyframes hostel-glow {
  0%, 100% {
    background:
      radial-gradient(ellipse 60% 100% at 80% 50%, rgba(232, 145, 109, 0.35) 0%, transparent 70%),
      linear-gradient(135deg, #1E5266 0%, #0F3848 100%);
  }
  50% {
    background:
      radial-gradient(ellipse 80% 100% at 75% 45%, rgba(232, 145, 109, 0.5) 0%, transparent 72%),
      linear-gradient(135deg, #1E5266 0%, #0F3848 100%);
  }
}

/* 右侧海岛主题装饰 · 海平线 + 月亮 + 灯塔 */
.hostel-deco {
  position: absolute;
  top: 0;
  right: 0;
  width: 360rpx;
  height: 320rpx;
  pointer-events: none;
  opacity: 0.85;
  animation: hostel-deco-float 10s ease-in-out infinite;
}

@keyframes hostel-deco-float {
  0%, 100% { transform: translateY(0) translateX(0); }
  50%      { transform: translateY(-8rpx) translateX(-4rpx); }
}

/* 漂浮星光 · 三颗错相位脉动 */
.hostel-star {
  position: absolute;
  border-radius: 50%;
  background: #FFFFFF;
  pointer-events: none;
  filter: blur(0.5rpx);
}

.star-1 {
  top: 60rpx;
  right: 90rpx;
  width: 8rpx;
  height: 8rpx;
  opacity: 0.85;
  box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.7);
  animation: star-twinkle 2.8s ease-in-out infinite;
}

.star-2 {
  top: 130rpx;
  right: 220rpx;
  width: 5rpx;
  height: 5rpx;
  opacity: 0.65;
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.55);
  animation: star-twinkle 3.6s ease-in-out infinite;
  animation-delay: -1.2s;
}

.star-3 {
  top: 30rpx;
  right: 170rpx;
  width: 4rpx;
  height: 4rpx;
  opacity: 0.55;
  box-shadow: 0 0 6rpx rgba(255, 255, 255, 0.5);
  animation: star-twinkle 4.2s ease-in-out infinite;
  animation-delay: -2.5s;
}

@keyframes star-twinkle {
  0%, 100% { opacity: 0.25; transform: scale(0.8); }
  50%      { opacity: 1; transform: scale(1.3); }
}

/* 底部光带 · 横向漂移的月光倒影 */
.hostel-glow {
  position: absolute;
  left: -10%;
  right: -10%;
  bottom: 0;
  height: 60rpx;
  pointer-events: none;
  background:
    radial-gradient(ellipse 80rpx 30rpx at 25% 80%, rgba(255, 255, 255, 0.18) 0%, transparent 70%),
    radial-gradient(ellipse 120rpx 35rpx at 65% 85%, rgba(232, 145, 109, 0.22) 0%, transparent 70%),
    radial-gradient(ellipse 90rpx 30rpx at 90% 80%, rgba(255, 255, 255, 0.14) 0%, transparent 70%);
  animation: hostel-glow-drift 9s ease-in-out infinite;
}

@keyframes hostel-glow-drift {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(30rpx); }
}

.hostel-card-content {
  position: relative;
  z-index: 2;
  padding: var(--space-xl);
  color: var(--text-white);
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.hostel-card-cta {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--font-base);
  font-weight: 500;
  margin-top: auto;
}

.hostel-card-eyebrow {
  font-size: var(--font-xs);
  letter-spacing: 5rpx;
  opacity: 0.85;
  font-weight: 500;
}

.hostel-card-title {
  font-size: var(--font-2xl);
  font-weight: 700;
  letter-spacing: -0.5rpx;
  margin-top: var(--space-xs);
}

.hostel-card-desc {
  font-size: var(--font-sm);
  opacity: 0.8;
  margin-top: 4rpx;
  margin-bottom: var(--space-md);
}

.hostel-card-cta {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--font-base);
  font-weight: 500;
}

.hostel-card-arrow {
  width: 28rpx;
  height: 28rpx;
}

/* ============ Footer Tag ============ */
.home-footer-tag {
  margin-top: var(--space-2xl);
  text-align: center;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  letter-spacing: 3rpx;
}
