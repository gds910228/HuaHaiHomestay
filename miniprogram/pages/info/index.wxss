/* pages/info/index.wxss · 实用信息 · 沙金棕 */
.cat-page {
  min-height: 100vh;
  background: var(--bg-canvas);
  padding-bottom: 80rpx;
}

.cat-hero {
  padding: var(--space-2xl) var(--space-xl) var(--space-xl);
  background: var(--cat-info);
  color: var(--text-white);
}
/* Hero · 多层装饰 (主题图 + 气泡 + 星光 + 底光) */
.cat-hero {
  position: relative;
  overflow: hidden;
}

.hero-meta {
  position: relative;
  z-index: 3;
}

/* 1. 主题装饰图 · 右上漂浮 + 旋转 */
.hero-deco {
  position: absolute;
  top: -20rpx;
  right: -30rpx;
  width: 320rpx;
  height: 320rpx;
  pointer-events: none;
  animation: hero-deco-float 11s ease-in-out infinite;
}

@keyframes hero-deco-float {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  33%      { transform: translate(-10rpx, 8rpx) rotate(-4deg); }
  66%      { transform: translate(8rpx, -8rpx) rotate(4deg); }
}

/* 2. 浮动气泡 · 3 个大圆,白色描边,缓慢上升 */
.hero-bubble {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  pointer-events: none;
}

.bubble-1 {
  bottom: -40rpx;
  left: 60rpx;
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.06);
  animation: bubble-rise 12s ease-in-out infinite;
}

.bubble-2 {
  bottom: -30rpx;
  left: 280rpx;
  width: 50rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.08);
  animation: bubble-rise 14s ease-in-out infinite;
  animation-delay: -4s;
}

.bubble-3 {
  bottom: -50rpx;
  right: 60rpx;
  width: 110rpx;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.04);
  animation: bubble-rise 16s ease-in-out infinite;
  animation-delay: -8s;
}

@keyframes bubble-rise {
  0%   { transform: translateY(0) scale(1); opacity: 0.5; }
  50%  { transform: translateY(-30rpx) scale(1.05); opacity: 0.75; }
  100% { transform: translateY(0) scale(1); opacity: 0.5; }
}

/* 3. 星光 · 三颗错相位脉动 */
.hero-spark {
  position: absolute;
  border-radius: 50%;
  background: #FFFFFF;
  pointer-events: none;
  filter: blur(0.5rpx);
  z-index: 2;
}

.spark-1 {
  top: 50rpx;
  right: 140rpx;
  width: 10rpx;
  height: 10rpx;
  opacity: 0.85;
  box-shadow: 0 0 16rpx rgba(255, 255, 255, 0.8);
  animation: hero-twinkle 2.6s ease-in-out infinite;
}

.spark-2 {
  top: 130rpx;
  right: 250rpx;
  width: 6rpx;
  height: 6rpx;
  opacity: 0.7;
  box-shadow: 0 0 10rpx rgba(255, 255, 255, 0.6);
  animation: hero-twinkle 3.8s ease-in-out infinite;
  animation-delay: -1.5s;
}

.spark-3 {
  top: 90rpx;
  right: 80rpx;
  width: 4rpx;
  height: 4rpx;
  opacity: 0.6;
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.55);
  animation: hero-twinkle 4.5s ease-in-out infinite;
  animation-delay: -3s;
}

@keyframes hero-twinkle {
  0%, 100% { opacity: 0.2; transform: scale(0.7); }
  50%      { opacity: 1; transform: scale(1.4); }
}

/* 4. 底部光带 · 横向漂移 */
.hero-glow {
  position: absolute;
  left: -10%;
  right: -10%;
  bottom: -10rpx;
  height: 80rpx;
  pointer-events: none;
  background:
    radial-gradient(ellipse 90rpx 35rpx at 25% 80%, rgba(255, 255, 255, 0.28) 0%, transparent 70%),
    radial-gradient(ellipse 140rpx 40rpx at 60% 85%, rgba(255, 255, 255, 0.22) 0%, transparent 70%),
    radial-gradient(ellipse 100rpx 35rpx at 90% 80%, rgba(255, 255, 255, 0.26) 0%, transparent 70%);
  animation: hero-glow-drift 9s ease-in-out infinite;
}

@keyframes hero-glow-drift {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(40rpx); }
}

.hero-eyebrow {
  font-size: var(--font-xs);
  letter-spacing: 4rpx;
  opacity: 0.85;
  font-weight: 500;
  margin-bottom: var(--space-xs);
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.15;
  margin-bottom: 6rpx;
}

.hero-sub {
  font-size: var(--font-sm);
  opacity: 0.82;
  letter-spacing: 0.5rpx;
}

.tag-filter-bar {
  position: relative;
  margin: -32rpx var(--space-lg) var(--space-md);
  padding: var(--space-md) var(--space-md) 10rpx;
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  z-index: 2;
}

.tag-filter-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  overflow: hidden;
  max-height: 116rpx;
  transition: max-height 0.25s ease;
}

.tag-filter-wrap.expanded { max-height: 2000rpx; }

.tag-chip {
  flex: none;
  height: 56rpx;
  padding: 0 22rpx;
  line-height: 52rpx;
  font-size: var(--font-xs);
  color: var(--text-secondary);
  background: var(--bg-muted);
  border-radius: var(--radius-pill);
  border: 2rpx solid transparent;
  transition: all var(--duration-fast) var(--ease-out);
}

.tag-chip.active {
  background: var(--cat-info);
  color: var(--text-white);
  border-color: var(--cat-info);
}

.tag-filter-toggle {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
  padding: 6rpx 0;
  font-size: var(--font-xs);
  color: var(--cat-info);
  letter-spacing: 1rpx;
}

.toggle-icon { width: 20rpx; height: 20rpx; transition: transform 200ms var(--ease-out); }
.toggle-icon.up { transform: rotate(180deg); }

.skeleton-wrapper { padding: 0 var(--space-lg); }
.list-area { padding: 0 var(--space-lg); }

.card-list { display: flex; flex-direction: column; gap: var(--space-lg); }

.guide-card {
  background: var(--bg-surface);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: all var(--duration-fast) var(--ease-out);
}

.guide-card:active { transform: scale(0.99); box-shadow: var(--shadow-sm); }

.guide-no-image {
  width: 100%;
  height: 240rpx;
  background: var(--cat-info-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.no-image-icon { width: 64rpx; height: 64rpx; opacity: 0.75; }

.no-image-text {
  font-size: var(--font-xs);
  color: var(--cat-info);
  letter-spacing: 1rpx;
}

.guide-info { padding: var(--space-lg); }

.guide-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
  line-height: 1.35;
  margin-bottom: var(--space-sm);
}

.guide-address { display: flex; align-items: center; gap: 6rpx; margin-bottom: var(--space-sm); }
.addr-icon { width: 24rpx; height: 24rpx; flex-shrink: 0; }
.addr-text { flex: 1; font-size: var(--font-xs); color: var(--text-secondary); }
.guide-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: var(--space-sm); }

.guide-desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: var(--space-md);
}

.guide-actions {
  display: flex;
  gap: 12rpx;
  padding-top: var(--space-md);
  border-top: 2rpx solid var(--divider-color);
}

.action-btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 72rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-sm);
  font-weight: 500;
  padding: 0 16rpx;
  transition: all var(--duration-fast) var(--ease-out);
}

.action-btn:active { transform: scale(0.96); }

.nav-btn { background: var(--brand-primary); color: var(--text-white); }

.fav-btn {
  background: var(--bg-muted);
  color: var(--cat-info);
  border: 2rpx solid var(--cat-info-soft);
}

.fav-btn.favorited {
  background: var(--cat-info);
  color: var(--text-white);
  border-color: var(--cat-info);
}

.action-icon { width: 26rpx; height: 26rpx; }
