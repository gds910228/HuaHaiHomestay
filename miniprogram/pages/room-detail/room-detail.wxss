/* pages/room-detail/room-detail.wxss */
.room-detail-page {
  min-height: 100vh;
  background: var(--bg-canvas);
  padding-bottom: 180rpx;
}

/* === 图片 === */
.image-swiper-container {
  position: relative;
  width: 100%;
  height: 600rpx;
  background: var(--bg-muted);
}

.image-swiper,
.room-image {
  width: 100%;
  height: 100%;
}

.image-tint {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, transparent 65%, rgba(15, 56, 72, 0.4) 100%);
}

.image-counter {
  position: absolute;
  bottom: var(--space-lg);
  right: var(--space-lg);
  padding: 8rpx 18rpx;
  background: rgba(30, 56, 72, 0.72);
  backdrop-filter: blur(10rpx);
  color: var(--text-white);
  font-size: var(--font-xs);
  border-radius: var(--radius-pill);
  letter-spacing: 0.5rpx;
}

/* === 信息 sheet === */
.info-sheet {
  margin: -48rpx var(--space-lg) var(--space-lg);
  padding: var(--space-xl);
  background: var(--bg-surface);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 2;
}

.room-header { margin-bottom: var(--space-lg); }

.room-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.room-type {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

.room-category-pill {
  padding: 4rpx 16rpx;
  background: var(--brand-primary-soft);
  color: var(--brand-primary);
  font-size: var(--font-xs);
  font-weight: 600;
  border-radius: var(--radius-pill);
}

.room-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: var(--space-sm); }

/* 价格 */
.price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: var(--space-lg);
  padding: var(--space-md) 0;
  border-bottom: 2rpx solid var(--divider-color);
}

.price-symbol { font-size: var(--font-xl); color: var(--brand-accent-strong); font-weight: 600; }
.price-value { font-size: 56rpx; font-weight: 700; color: var(--brand-accent-strong); letter-spacing: -1rpx; }
.price-unit { font-size: var(--font-sm); color: var(--text-tertiary); margin-left: 4rpx; }

/* 基础信息 */
.room-basic-info {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-md);
}

.basic-info-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: var(--space-md);
  background: var(--bg-muted);
  border-radius: var(--radius-md);
}

.basic-info-icon { width: 32rpx; height: 32rpx; flex-shrink: 0; }
.basic-info-text { font-size: var(--font-sm); color: var(--text-primary); font-weight: 500; }

/* === 区块通用 === */
.section-block {
  margin: var(--space-lg);
  padding: var(--space-xl);
  background: var(--bg-surface);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-sm);
}

.section-eyebrow {
  font-size: var(--font-xs);
  letter-spacing: 4rpx;
  color: var(--text-tertiary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.section-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

.section-head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: var(--space-md);
}

.facility-count {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  font-variant-numeric: tabular-nums;
}

.description-text {
  margin-top: var(--space-sm);
  font-size: var(--font-base);
  color: var(--text-primary);
  line-height: 1.85;
}

/* === Facility 折叠组 === */
.facility-category {
  border-bottom: 2rpx solid var(--divider-color);
  padding: var(--space-md) 0;
}

.facility-category:last-child { border-bottom: none; }

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.category-left { display: flex; align-items: center; gap: 12rpx; }

.category-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-md);
  background: var(--brand-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-icon image { width: 32rpx; height: 32rpx; }

.category-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.3rpx;
}

.chevron {
  width: 32rpx;
  height: 32rpx;
  transition: transform 200ms var(--ease-out);
}

.chevron.open { transform: rotate(180deg); }

.facility-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-sm) var(--space-md);
  padding: var(--space-md) 0 0 68rpx;
}

.facility-item { display: flex; align-items: center; gap: 10rpx; }

.facility-tick {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--brand-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.facility-tick image { width: 20rpx; height: 20rpx; }
.facility-name { font-size: var(--font-sm); color: var(--text-primary); }

/* === Collapsible === */
.collapsible-head { display: flex; justify-content: space-between; align-items: center; }

.rules-list {
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: 2rpx solid var(--divider-color);
}

.rule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

.rule-label { font-size: var(--font-sm); color: var(--text-tertiary); letter-spacing: 0.5rpx; }
.rule-value { font-size: var(--font-sm); color: var(--text-primary); font-weight: 500; }

/* === 接待要求 === */
.requirements-grid {
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: 2rpx solid var(--divider-color);
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-sm);
}

.req-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.req-label { font-size: var(--font-sm); color: var(--text-secondary); }

.req-pill {
  padding: 4rpx 16rpx;
  font-size: var(--font-xs);
  font-weight: 600;
  border-radius: var(--radius-pill);
}

.req-pill.allowed { background: var(--color-success-soft); color: var(--color-success); }
.req-pill.not-allowed { background: var(--color-danger-soft); color: var(--color-danger); }

.bottom-placeholder { height: 120rpx; }

/* === 底部操作栏 === */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(251, 247, 240, 0.94);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 16rpx rgba(94, 72, 50, 0.06);
  padding: var(--space-md) var(--space-lg);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  z-index: 10;
}

.action-buttons { display: flex; gap: var(--space-sm); }

.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-base);
  font-weight: 600;
  transition: all var(--duration-fast) var(--ease-out);
}

.action-btn:active { transform: scale(0.96); }

.ghost-btn {
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
  background: var(--bg-muted);
  color: var(--text-primary);
  font-size: var(--font-xs);
}

.action-btn-icon { width: 36rpx; height: 36rpx; }
.action-text { font-size: 22rpx; color: var(--text-secondary); letter-spacing: 0.5rpx; }

.book-btn,
.back-btn {
  flex: 2.2;
  background: var(--brand-primary);
  color: var(--text-white);
  box-shadow: var(--shadow-brand);
}

.btn-text { font-size: var(--font-lg); color: var(--text-white); letter-spacing: 1rpx; }

.loading-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
