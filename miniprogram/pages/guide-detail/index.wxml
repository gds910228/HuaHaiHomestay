<!--pages/guide-detail/index.wxml-->
<view class="detail-container" wx:if="{{!loading && guide}}">
  <!-- 顶部图片轮播 -->
  <view class="detail-images">
    <swiper class="images-swiper" indicator-dots="{{guide.images.length > 1}}" indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#FFFFFF" autoplay circular>
      <swiper-item wx:for="{{guide.images}}" wx:key="*this">
        <image
          class="detail-image"
          src="{{item}}"
          mode="aspectFill"
          data-url="{{item}}"
          data-urls="{{guide.images}}"
          bindtap="previewImage"
        ></image>
      </swiper-item>
    </swiper>
    <view class="images-tint"></view>
  </view>

  <!-- 内容 sheet (上凸) -->
  <view class="detail-content">
    <!-- 类目 + 收藏 -->
    <view class="detail-header">
      <view class="header-left">
        <view class="detail-category">{{guide.categoryName}}</view>
        <text class="detail-title">{{guide.title}}</text>
      </view>
      <view class="action-fab {{isFavorite ? 'fav-active' : ''}}" bindtap="toggleFavorite">
        <image
          wx:if="{{isFavorite}}"
          class="fav-icon"
          src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23E8916D' stroke='%23E8916D' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M20.84 4.61 a 5.5 5.5 0 0 0 -7.78 0 L 12 5.67 l -1.06 -1.06 a 5.5 5.5 0 0 0 -7.78 7.78 l 1.06 1.06 L 12 21.23 l 7.78 -7.78 1.06 -1.06 a 5.5 5.5 0 0 0 0 -7.78 z'/%3E%3C/svg%3E"
          mode="aspectFit"
        ></image>
        <image
          wx:else
          class="fav-icon"
          src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231E5266' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M20.84 4.61 a 5.5 5.5 0 0 0 -7.78 0 L 12 5.67 l -1.06 -1.06 a 5.5 5.5 0 0 0 -7.78 7.78 l 1.06 1.06 L 12 21.23 l 7.78 -7.78 1.06 -1.06 a 5.5 5.5 0 0 0 0 -7.78 z'/%3E%3C/svg%3E"
          mode="aspectFit"
        ></image>
      </view>
    </view>

    <!-- 标签 -->
    <view class="detail-tags" wx:if="{{guide.tags && guide.tags.length > 0}}">
      <view class="tag tag-brand" wx:for="{{guide.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</view>
    </view>

    <!-- 统计信息 -->
    <view class="detail-stats">
      <view class="stat-item">
        <image class="stat-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23A39A8D' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M1 12 s 4 -8 11 -8 11 8 11 8 -4 8 -11 8 -11 -8 -11 -8 z'/%3E%3Ccircle cx='12' cy='12' r='3'/%3E%3C/svg%3E" mode="aspectFit"></image>
        <text class="stat-value tabular-nums">{{guide.views || 0}}</text>
      </view>
      <view class="stat-item" wx:if="{{guide.likes > 0}}">
        <image class="stat-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23E8916D' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M20.84 4.61 a 5.5 5.5 0 0 0 -7.78 0 L 12 5.67 l -1.06 -1.06 a 5.5 5.5 0 0 0 -7.78 7.78 l 1.06 1.06 L 12 21.23 l 7.78 -7.78 1.06 -1.06 a 5.5 5.5 0 0 0 0 -7.78 z'/%3E%3C/svg%3E" mode="aspectFit"></image>
        <text class="stat-value tabular-nums">{{guide.likes || 0}}</text>
      </view>
    </view>

    <!-- 分割线 -->
    <view class="divider"></view>

    <!-- 详细内容 -->
    <view class="detail-body">
      <view class="body-section-eyebrow">DETAILS · 详细介绍</view>
      <rich-text class="body-content" nodes="{{guide.content}}"></rich-text>
    </view>

    <!-- 实用信息 -->
    <view class="detail-info" wx:if="{{guide.info}}">
      <view class="body-section-eyebrow">INFO · 实用信息</view>
      <view class="info-item" wx:for="{{guide.info}}" wx:key="label">
        <text class="info-label">{{item.label}}</text>
        <text class="info-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="detail-footer">
    <button class="footer-btn footer-btn-secondary" open-type="share">
      <image class="footer-btn-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231E5266' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M4 12 v 8 a 2 2 0 0 0 2 2 h 12 a 2 2 0 0 0 2 -2 v -8'/%3E%3Cpath d='M16 6 l -4 -4 -4 4 M 12 2 v 14'/%3E%3C/svg%3E" mode="aspectFit"></image>
      <text>分享</text>
    </button>
    <button class="footer-btn footer-btn-primary" bindtap="navigate" wx:if="{{guide.location}}">
      <image class="footer-btn-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23FFFFFF' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 22 s -7 -7 -7 -13 a 7 7 0 0 1 14 0 c 0 6 -7 13 -7 13 z'/%3E%3Ccircle cx='12' cy='9' r='2.4'/%3E%3C/svg%3E" mode="aspectFit"></image>
      <text>一键导航</text>
    </button>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-container" wx:if="{{loading}}">
  <loading-state text="正在加载攻略..."></loading-state>
</view>
