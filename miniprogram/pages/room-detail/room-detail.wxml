<!--pages/room-detail/room-detail.wxml-->
<view class="room-detail-page" wx:if="{{!loading && room}}">

  <!-- 图片轮播 -->
  <view class="image-swiper-container">
    <swiper
      class="image-swiper"
      indicator-dots="{{false}}"
      autoplay="{{false}}"
      bindchange="onImageChange">
      <swiper-item wx:for="{{room.images}}" wx:key="index">
        <image
          class="room-image"
          src="{{item}}"
          mode="aspectFill"
          bindtap="previewImage"
          data-url="{{item}}"
          data-urls="{{room.images}}" />
      </swiper-item>
    </swiper>
    <view class="image-tint"></view>
    <view class="image-counter tabular-nums">{{currentImageIndex + 1}} / {{room.images.length}}</view>
  </view>

  <!-- 房型基本信息 -->
  <view class="info-sheet">
    <view class="room-header">
      <view class="room-title-row">
        <text class="room-type">{{room.roomType}}</text>
        <view class="room-category-pill" wx:if="{{room.roomCategory}}">{{room.roomCategory}}</view>
      </view>
      <view class="room-tags" wx:if="{{room.tags && room.tags.length > 0}}">
        <view class="tag tag-brand" wx:for="{{room.tags}}" wx:key="index" wx:for-item="tag">{{tag}}</view>
      </view>
    </view>

    <view class="price-row">
      <text class="price-symbol">¥</text>
      <text class="price-value tabular-nums">{{room.displayPrice}}</text>
      <text class="price-unit">/晚</text>
    </view>

    <view class="room-basic-info">
      <view class="basic-info-item">
        <image class="basic-info-icon" src="/images/icons/area.svg" mode="aspectFit"></image>
        <text class="basic-info-text">{{room.area || '面积未知'}}</text>
      </view>
      <view class="basic-info-item">
        <image class="basic-info-icon" src="/images/icons/bed.svg" mode="aspectFit"></image>
        <text class="basic-info-text">{{room.bedType || '床型未知'}}</text>
      </view>
      <view class="basic-info-item" wx:if="{{room.maxGuests}}">
        <image class="basic-info-icon" src="/images/icons/users.svg" mode="aspectFit"></image>
        <text class="basic-info-text">{{room.guestDisplay}}</text>
      </view>
      <view class="basic-info-item" wx:if="{{room.breakfast}}">
        <image class="basic-info-icon" src="/images/icons/coffee.svg" mode="aspectFit"></image>
        <text class="basic-info-text">{{room.breakfast}}</text>
      </view>
    </view>
  </view>

  <!-- 房型描述 -->
  <view class="section-block" wx:if="{{room.description}}">
    <view class="section-eyebrow">DESCRIPTION · 房型介绍</view>
    <view class="description-text">{{room.description}}</view>
  </view>

  <!-- 设施服务 -->
  <view class="section-block" wx:if="{{room.detailedFacilities}}">
    <view class="section-head-row">
      <view>
        <view class="section-eyebrow">AMENITIES · 设施服务</view>
        <view class="section-title">房间里都有什么</view>
      </view>
      <view class="facility-count">共 {{room.detailedFacilities.services.length +
        room.detailedFacilities.basic.length +
        room.detailedFacilities.bathroom.length +
        room.detailedFacilities.kitchen.length +
        room.detailedFacilities.surroundings.length +
        room.detailedFacilities.safety.length +
        room.detailedFacilities.entertainment.length +
        room.detailedFacilities.leisure.length}}项</view>
    </view>

    <!-- 服务 -->
    <view class="facility-category" wx:if="{{room.detailedFacilities.services.length > 0}}">
      <view class="category-header" bindtap="toggleFacilityCategory" data-category="services">
        <view class="category-left">
          <view class="category-icon">
            <image src="/images/icons/service.svg" mode="aspectFit"></image>
          </view>
          <text class="category-title">服务</text>
        </view>
        <image class="chevron {{showServices ? 'open' : ''}}" src="/images/icons/chevron-down.svg" mode="aspectFit"></image>
      </view>
      <view class="facility-list" wx:if="{{showServices}}">
        <view class="facility-item" wx:for="{{room.detailedFacilities.services}}" wx:key="index">
          <view class="facility-tick">
            <image src="/images/icons/check.svg" mode="aspectFit"></image>
          </view>
          <text class="facility-name">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 基础 -->
    <view class="facility-category" wx:if="{{room.detailedFacilities.basic.length > 0}}">
      <view class="category-header" bindtap="toggleFacilityCategory" data-category="basic">
        <view class="category-left">
          <view class="category-icon">
            <image src="/images/icons/house.svg" mode="aspectFit"></image>
          </view>
          <text class="category-title">基础</text>
        </view>
        <image class="chevron {{showBasic ? 'open' : ''}}" src="/images/icons/chevron-down.svg" mode="aspectFit"></image>
      </view>
      <view class="facility-list" wx:if="{{showBasic}}">
        <view class="facility-item" wx:for="{{room.detailedFacilities.basic}}" wx:key="index">
          <view class="facility-tick">
            <image src="/images/icons/check.svg" mode="aspectFit"></image>
          </view>
          <text class="facility-name">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 卫浴 -->
    <view class="facility-category" wx:if="{{room.detailedFacilities.bathroom.length > 0}}">
      <view class="category-header" bindtap="toggleFacilityCategory" data-category="bathroom">
        <view class="category-left">
          <view class="category-icon">
            <image src="/images/icons/shower.svg" mode="aspectFit"></image>
          </view>
          <text class="category-title">卫浴</text>
        </view>
        <image class="chevron {{showBathroom ? 'open' : ''}}" src="/images/icons/chevron-down.svg" mode="aspectFit"></image>
      </view>
      <view class="facility-list" wx:if="{{showBathroom}}">
        <view class="facility-item" wx:for="{{room.detailedFacilities.bathroom}}" wx:key="index">
          <view class="facility-tick">
            <image src="/images/icons/check.svg" mode="aspectFit"></image>
          </view>
          <text class="facility-name">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 厨房 -->
    <view class="facility-category" wx:if="{{room.detailedFacilities.kitchen.length > 0}}">
      <view class="category-header" bindtap="toggleFacilityCategory" data-category="kitchen">
        <view class="category-left">
          <view class="category-icon">
            <image src="/images/icons/coffee.svg" mode="aspectFit"></image>
          </view>
          <text class="category-title">厨房</text>
        </view>
        <image class="chevron {{showKitchen ? 'open' : ''}}" src="/images/icons/chevron-down.svg" mode="aspectFit"></image>
      </view>
      <view class="facility-list" wx:if="{{showKitchen}}">
        <view class="facility-item" wx:for="{{room.detailedFacilities.kitchen}}" wx:key="index">
          <view class="facility-tick">
            <image src="/images/icons/check.svg" mode="aspectFit"></image>
          </view>
          <text class="facility-name">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 周边 -->
    <view class="facility-category" wx:if="{{room.detailedFacilities.surroundings.length > 0}}">
      <view class="category-header" bindtap="toggleFacilityCategory" data-category="surroundings">
        <view class="category-left">
          <view class="category-icon">
            <image src="/images/icons/building.svg" mode="aspectFit"></image>
          </view>
          <text class="category-title">周边</text>
        </view>
        <image class="chevron {{showSurroundings ? 'open' : ''}}" src="/images/icons/chevron-down.svg" mode="aspectFit"></image>
      </view>
      <view class="facility-list" wx:if="{{showSurroundings}}">
        <view class="facility-item" wx:for="{{room.detailedFacilities.surroundings}}" wx:key="index">
          <view class="facility-tick">
            <image src="/images/icons/check.svg" mode="aspectFit"></image>
          </view>
          <text class="facility-name">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 安全 -->
    <view class="facility-category" wx:if="{{room.detailedFacilities.safety.length > 0}}">
      <view class="category-header" bindtap="toggleFacilityCategory" data-category="safety">
        <view class="category-left">
          <view class="category-icon">
            <image src="/images/icons/shield.svg" mode="aspectFit"></image>
          </view>
          <text class="category-title">安全</text>
        </view>
        <image class="chevron {{showSafety ? 'open' : ''}}" src="/images/icons/chevron-down.svg" mode="aspectFit"></image>
      </view>
      <view class="facility-list" wx:if="{{showSafety}}">
        <view class="facility-item" wx:for="{{room.detailedFacilities.safety}}" wx:key="index">
          <view class="facility-tick">
            <image src="/images/icons/check.svg" mode="aspectFit"></image>
          </view>
          <text class="facility-name">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 娱乐 -->
    <view class="facility-category" wx:if="{{room.detailedFacilities.entertainment.length > 0}}">
      <view class="category-header" bindtap="toggleFacilityCategory" data-category="entertainment">
        <view class="category-left">
          <view class="category-icon">
            <image src="/images/icons/tv.svg" mode="aspectFit"></image>
          </view>
          <text class="category-title">娱乐</text>
        </view>
        <image class="chevron {{showEntertainment ? 'open' : ''}}" src="/images/icons/chevron-down.svg" mode="aspectFit"></image>
      </view>
      <view class="facility-list" wx:if="{{showEntertainment}}">
        <view class="facility-item" wx:for="{{room.detailedFacilities.entertainment}}" wx:key="index">
          <view class="facility-tick">
            <image src="/images/icons/check.svg" mode="aspectFit"></image>
          </view>
          <text class="facility-name">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 休闲 -->
    <view class="facility-category" wx:if="{{room.detailedFacilities.leisure.length > 0}}">
      <view class="category-header" bindtap="toggleFacilityCategory" data-category="leisure">
        <view class="category-left">
          <view class="category-icon">
            <image src="/images/icons/leaf.svg" mode="aspectFit"></image>
          </view>
          <text class="category-title">休闲</text>
        </view>
        <image class="chevron {{showLeisure ? 'open' : ''}}" src="/images/icons/chevron-down.svg" mode="aspectFit"></image>
      </view>
      <view class="facility-list" wx:if="{{showLeisure}}">
        <view class="facility-item" wx:for="{{room.detailedFacilities.leisure}}" wx:key="index">
          <view class="facility-tick">
            <image src="/images/icons/check.svg" mode="aspectFit"></image>
          </view>
          <text class="facility-name">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 入住须知 -->
  <view class="section-block" wx:if="{{room.checkInRules}}">
    <view class="collapsible-head" bindtap="toggleCheckInRules">
      <view>
        <view class="section-eyebrow">CHECK-IN · 入住须知</view>
        <view class="section-title">入住前必读</view>
      </view>
      <image class="chevron {{showCheckInRules ? 'open' : ''}}" src="/images/icons/chevron-down.svg" mode="aspectFit"></image>
    </view>
    <view class="rules-list" wx:if="{{showCheckInRules}}">
      <view class="rule-item" wx:if="{{room.checkInRules.checkInTime}}">
        <text class="rule-label">入住时间</text>
        <text class="rule-value">{{room.checkInRules.checkInTime}}</text>
      </view>
      <view class="rule-item" wx:if="{{room.checkInRules.checkOutTime}}">
        <text class="rule-label">退房时间</text>
        <text class="rule-value">{{room.checkInRules.checkOutTime}}</text>
      </view>
      <view class="rule-item" wx:if="{{room.checkInRules.cancelPolicy}}">
        <text class="rule-label">取消政策</text>
        <text class="rule-value">{{room.checkInRules.cancelPolicy}}</text>
      </view>
      <view class="rule-item" wx:if="{{room.checkInRules.deposit}}">
        <text class="rule-label">押金</text>
        <text class="rule-value tabular-nums">¥{{room.checkInRules.deposit}}(离店后退还)</text>
      </view>
      <view class="rule-item" wx:if="{{room.checkInRules.instantConfirm !== undefined}}">
        <text class="rule-label">确认方式</text>
        <text class="rule-value">{{room.checkInRules.instantConfirm ? '即时确认有房' : '需提前与民宿主确认'}}</text>
      </view>
    </view>
  </view>

  <!-- 接待要求 -->
  <view class="section-block" wx:if="{{room.guestRequirements}}">
    <view class="collapsible-head" bindtap="toggleGuestRequirements">
      <view>
        <view class="section-eyebrow">GUEST · 接待要求</view>
        <view class="section-title">可以带谁来住</view>
      </view>
      <image class="chevron {{showGuestRequirements ? 'open' : ''}}" src="/images/icons/chevron-down.svg" mode="aspectFit"></image>
    </view>
    <view class="requirements-grid" wx:if="{{showGuestRequirements}}">
      <view class="req-item">
        <text class="req-label">接待婴儿</text>
        <view class="req-pill {{room.guestRequirements.allowInfants ? 'allowed' : 'not-allowed'}}">
          {{room.guestRequirements.allowInfants ? '允许' : '不允许'}}
        </view>
      </view>
      <view class="req-item">
        <text class="req-label">接待儿童</text>
        <view class="req-pill {{room.guestRequirements.allowChildren ? 'allowed' : 'not-allowed'}}">
          {{room.guestRequirements.allowChildren ? '允许' : '不允许'}}
        </view>
      </view>
      <view class="req-item">
        <text class="req-label">接待老人</text>
        <view class="req-pill {{room.guestRequirements.allowElderly ? 'allowed' : 'not-allowed'}}">
          {{room.guestRequirements.allowElderly ? '允许' : '不允许'}}
        </view>
      </view>
      <view class="req-item">
        <text class="req-label">携带宠物</text>
        <view class="req-pill {{room.guestRequirements.allowPets ? 'allowed' : 'not-allowed'}}">
          {{room.guestRequirements.allowPets ? '允许' : '不允许'}}
        </view>
      </view>
      <view class="req-item">
        <text class="req-label">允许吸烟</text>
        <view class="req-pill {{room.guestRequirements.allowSmoking ? 'allowed' : 'not-allowed'}}">
          {{room.guestRequirements.allowSmoking ? '允许' : '不允许'}}
        </view>
      </view>
      <view class="req-item">
        <text class="req-label">允许做饭</text>
        <view class="req-pill {{room.guestRequirements.allowCooking ? 'allowed' : 'not-allowed'}}">
          {{room.guestRequirements.allowCooking ? '允许' : '不允许'}}
        </view>
      </view>
      <view class="req-item">
        <text class="req-label">允许聚会</text>
        <view class="req-pill {{room.guestRequirements.allowParty ? 'allowed' : 'not-allowed'}}">
          {{room.guestRequirements.allowParty ? '允许' : '不允许'}}
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-placeholder"></view>

  <!-- 底部操作栏 -->
  <view class="bottom-action-bar">
    <view class="action-buttons">
      <view class="action-btn ghost-btn" bindtap="handleFavorite">
        <image
          wx:if="{{room.isFavorited}}"
          class="action-btn-icon"
          src="/images/icons/heart-filled.svg"
          mode="aspectFit"
        ></image>
        <image
          wx:else
          class="action-btn-icon"
          src="/images/icons/heart.svg"
          mode="aspectFit"
        ></image>
        <text class="action-text">收藏</text>
      </view>
      <view class="action-btn ghost-btn" bindtap="handleContact">
        <image class="action-btn-icon" src="/images/icons/phone-brand.svg" mode="aspectFit"></image>
        <text class="action-text">客服</text>
      </view>
      <view class="action-btn book-btn" bindtap="handleBooking">
        <text class="btn-text">咨询民宿主</text>
      </view>
    </view>
  </view>
</view>

<!-- 加载 -->
<view class="loading-container" wx:if="{{loading}}">
  <loading-state text="正在加载房型信息..."></loading-state>
</view>
