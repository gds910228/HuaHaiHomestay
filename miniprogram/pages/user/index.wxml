<!--pages/user/index.wxml-->
<view class="user-container">
  <!-- 用户信息卡 (暖米调 sheet) -->
  <view class="user-header">
    <view class="user-info">
      <image class="user-avatar" src="/images/logo.jpg" mode="aspectFill"></image>
      <view class="user-detail">
        <text class="user-name">画海民宿</text>
        <text class="user-desc">南澳岛 · 你的旅行收藏夹</text>
      </view>
    </view>
  </view>

  <!-- 收藏区 -->
  <view class="section-block">
    <view class="section-head">
      <view class="section-title-row">
        <view class="section-eyebrow">SAVED · 我的收藏</view>
        <text class="section-count" wx:if="{{favorites.length > 0}}">{{favorites.length}} 条</text>
      </view>
      <view class="section-title">收下心动的地方</view>
    </view>

    <!-- 加载状态 -->
    <loading-state wx:if="{{loading}}" text="加载收藏中..."></loading-state>

    <!-- 空状态 -->
    <empty-state
      wx:if="{{!loading && favorites.length === 0}}"
      title="收藏夹还空着"
      description="去攻略与房型里发现喜欢的内容,轻点 ♡ 即可加入"
      actionText="去首页逛逛"
      bind:action="goHome"
    ></empty-state>

    <!-- 收藏列表 -->
    <view class="favorites-list" wx:if="{{!loading && favorites.length > 0}}">
      <view
        class="favorite-card fade-in clickable"
        wx:for="{{favorites}}"
        wx:key="_id"
        data-id="{{item._id || item.roomId}}"
        data-category="{{item.category}}"
        bindtap="openGuide"
      >
        <image
          wx:if="{{item.displayImage}}"
          class="favorite-image"
          src="{{item.displayImage}}"
          mode="aspectFill"
        ></image>
        <view wx:else class="favorite-image favorite-image-placeholder">
          <image class="placeholder-svg" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23A39A8D' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'%3E%3Crect x='3' y='4' width='18' height='16' rx='2'/%3E%3Ccircle cx='9' cy='10' r='1.6'/%3E%3Cpath d='M3 17 l 5 -5 4 4 4 -3 5 6'/%3E%3C/svg%3E" mode="aspectFit"></image>
        </view>

        <view class="favorite-content">
          <view class="favorite-tag-row">
            <view class="tag {{item.category === 'room' ? 'tag-accent' : 'tag-brand'}}">
              {{item.category === 'room' ? '房型' : '攻略'}}
            </view>
          </view>
          <text class="favorite-title text-ellipsis">{{item.displayTitle}}</text>
          <text class="favorite-desc text-ellipsis">{{item.displayDesc}}</text>
        </view>

        <view
          class="favorite-remove clickable"
          catchtap="removeFavorite"
          data-id="{{item._id || item.roomId}}"
          data-favorite-id="{{item.favoriteId}}"
          data-category="{{item.category}}"
        >
          <image src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236B6359' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M6 6 l 12 12 M 18 6 l -12 12'/%3E%3C/svg%3E" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="section-block">
    <view class="section-head">
      <view class="section-eyebrow">MORE · 更多</view>
      <view class="section-title">服务与设置</view>
    </view>

    <view class="menu-list">
      <view class="menu-item clickable" bindtap="contactService">
        <view class="menu-left">
          <view class="menu-icon-wrap menu-icon-brand">
            <image class="menu-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231E5266' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M5 4 h 4 l 2 5 -3 2 a 11 11 0 0 0 5 5 l 2 -3 5 2 v 4 a 2 2 0 0 1 -2 2 A 17 17 0 0 1 3 6 a 2 2 0 0 1 2 -2'/%3E%3C/svg%3E" mode="aspectFit"></image>
          </view>
          <text class="menu-label">联系客服</text>
        </view>
        <image class="menu-arrow" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23A39A8D' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M9 6 l 6 6 -6 6'/%3E%3C/svg%3E" mode="aspectFit"></image>
      </view>

      <view class="menu-divider"></view>

      <view class="menu-item clickable" bindtap="showAbout">
        <view class="menu-left">
          <view class="menu-icon-wrap menu-icon-accent">
            <image class="menu-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23C76F4E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='12' cy='12' r='9'/%3E%3Cpath d='M12 8 v -.5 M 12 11 v 6'/%3E%3C/svg%3E" mode="aspectFit"></image>
          </view>
          <text class="menu-label">关于我们</text>
        </view>
        <image class="menu-arrow" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23A39A8D' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M9 6 l 6 6 -6 6'/%3E%3C/svg%3E" mode="aspectFit"></image>
      </view>

      <view class="menu-divider"></view>

      <view class="menu-item clickable" bindtap="goToInit">
        <view class="menu-left">
          <view class="menu-icon-wrap menu-icon-muted">
            <image class="menu-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236B6359' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 15 a 3 3 0 1 0 0 -6 3 3 0 0 0 0 6 z'/%3E%3Cpath d='M19.4 15 a 1.65 1.65 0 0 0 .33 1.82 l .06 .06 a 2 2 0 1 1 -2.83 2.83 l -.06 -.06 a 1.65 1.65 0 0 0 -1.82 -.33 1.65 1.65 0 0 0 -1 1.51 V 21 a 2 2 0 1 1 -4 0 v -.09 a 1.65 1.65 0 0 0 -1.08 -1.51 1.65 1.65 0 0 0 -1.82 .33 l -.06 .06 a 2 2 0 1 1 -2.83 -2.83 l .06 -.06 A 1.65 1.65 0 0 0 4.6 15 a 1.65 1.65 0 0 0 -1.51 -1 H 3 a 2 2 0 1 1 0 -4 h .09 A 1.65 1.65 0 0 0 4.6 9 a 1.65 1.65 0 0 0 -.33 -1.82 l -.06 -.06 a 2 2 0 1 1 2.83 -2.83 l .06 .06 a 1.65 1.65 0 0 0 1.82 .33 H 9 a 1.65 1.65 0 0 0 1 -1.51 V 3 a 2 2 0 1 1 4 0 v .09 a 1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82 -.33 l .06 -.06 a 2 2 0 1 1 2.83 2.83 l -.06 .06 a 1.65 1.65 0 0 0 -.33 1.82 V 9 a 1.65 1.65 0 0 0 1.51 1 H 21 a 2 2 0 1 1 0 4 h -.09 a 1.65 1.65 0 0 0 -1.51 1 z'/%3E%3C/svg%3E" mode="aspectFit"></image>
          </view>
          <text class="menu-label">数据初始化</text>
        </view>
        <image class="menu-arrow" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23A39A8D' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M9 6 l 6 6 -6 6'/%3E%3C/svg%3E" mode="aspectFit"></image>
      </view>
    </view>
  </view>
</view>
