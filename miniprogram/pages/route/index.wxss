/* pages/route/index.wxss · 路线 · 海藻青 */
.cat-page {
  min-height: 100vh;
  background: var(--bg-canvas);
  padding-bottom: 80rpx;
}

/* === Hero · 保留原多层装饰 === */
.cat-hero {
  position: relative;
  overflow: hidden;
  padding: var(--space-2xl) var(--space-xl) var(--space-xl);
  background: var(--cat-route);
  color: var(--text-white);
}

.hero-meta { position: relative; z-index: 3; }

.hero-deco {
  position: absolute;
  top: -20rpx; right: -30rpx;
  width: 320rpx; height: 320rpx;
  pointer-events: none;
  animation: hero-deco-float 11s ease-in-out infinite;
}

@keyframes hero-deco-float {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  33%      { transform: translate(-10rpx, 8rpx) rotate(-4deg); }
  66%      { transform: translate(8rpx, -8rpx) rotate(4deg); }
}

.hero-bubble {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  pointer-events: none;
}
.bubble-1 { bottom: -40rpx; left: 60rpx; width: 80rpx; height: 80rpx; background: rgba(255,255,255,0.06); animation: bubble-rise 12s ease-in-out infinite; }
.bubble-2 { bottom: -30rpx; left: 280rpx; width: 50rpx; height: 50rpx; background: rgba(255,255,255,0.08); animation: bubble-rise 14s ease-in-out infinite; animation-delay: -4s; }
.bubble-3 { bottom: -50rpx; right: 60rpx; width: 110rpx; height: 110rpx; background: rgba(255,255,255,0.04); animation: bubble-rise 16s ease-in-out infinite; animation-delay: -8s; }

@keyframes bubble-rise {
  0%   { transform: translateY(0) scale(1); opacity: 0.5; }
  50%  { transform: translateY(-30rpx) scale(1.05); opacity: 0.75; }
  100% { transform: translateY(0) scale(1); opacity: 0.5; }
}

.hero-spark {
  position: absolute; border-radius: 50%; background: #FFFFFF;
  pointer-events: none; filter: blur(0.5rpx); z-index: 2;
}
.spark-1 { top: 50rpx; right: 140rpx; width: 10rpx; height: 10rpx; opacity: 0.85; box-shadow: 0 0 16rpx rgba(255,255,255,0.8); animation: hero-twinkle 2.6s ease-in-out infinite; }
.spark-2 { top: 130rpx; right: 250rpx; width: 6rpx; height: 6rpx; opacity: 0.7; box-shadow: 0 0 10rpx rgba(255,255,255,0.6); animation: hero-twinkle 3.8s ease-in-out infinite; animation-delay: -1.5s; }
.spark-3 { top: 90rpx; right: 80rpx; width: 4rpx; height: 4rpx; opacity: 0.6; box-shadow: 0 0 8rpx rgba(255,255,255,0.55); animation: hero-twinkle 4.5s ease-in-out infinite; animation-delay: -3s; }

@keyframes hero-twinkle {
  0%, 100% { opacity: 0.2; transform: scale(0.7); }
  50%      { opacity: 1; transform: scale(1.4); }
}

.hero-glow {
  position: absolute; left: -10%; right: -10%; bottom: -10rpx; height: 80rpx;
  pointer-events: none;
  background:
    radial-gradient(ellipse 90rpx 35rpx at 25% 80%, rgba(255,255,255,0.28) 0%, transparent 70%),
    radial-gradient(ellipse 140rpx 40rpx at 60% 85%, rgba(255,255,255,0.22) 0%, transparent 70%),
    radial-gradient(ellipse 100rpx 35rpx at 90% 80%, rgba(255,255,255,0.26) 0%, transparent 70%);
  animation: hero-glow-drift 9s ease-in-out infinite;
}

@keyframes hero-glow-drift {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(40rpx); }
}

.hero-eyebrow {
  font-size: var(--font-xs); letter-spacing: 4rpx;
  opacity: 0.85; font-weight: 500; margin-bottom: var(--space-xs);
}
.hero-title {
  font-size: 56rpx; font-weight: 700;
  letter-spacing: -1rpx; line-height: 1.15; margin-bottom: 6rpx;
}
.hero-sub {
  font-size: var(--font-sm); opacity: 0.82; letter-spacing: 0.5rpx;
}

/* === 离线提示条 === */
.offline-banner {
  margin: -32rpx var(--space-lg) var(--space-md);
  padding: 14rpx 24rpx;
  background: #FFF6E5;
  border: 2rpx solid #F0C870;
  border-radius: var(--radius-md);
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-xs);
  color: #8B6914;
}
.offline-dot {
  color: #E89A3C;
  font-size: 16rpx;
  animation: dot-pulse 1.5s ease-in-out infinite;
}
@keyframes dot-pulse {
  0%, 100% { opacity: 0.4; }
  50%      { opacity: 1; }
}

/* === Day Tab Bar === */
.days-tab-bar {
  display: flex;
  gap: 8rpx;
  padding: var(--space-md) var(--space-lg) var(--space-sm);
  overflow-x: auto;
}
.days-tab-bar::-webkit-scrollbar { display: none; }

.days-tab {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 60rpx;
  padding: 0 28rpx;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  background: var(--bg-surface);
  border-radius: var(--radius-pill);
  border: 2rpx solid transparent;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  transition: all var(--duration-fast) var(--ease-out);
}

.days-tab.active {
  background: var(--cat-route);
  color: var(--text-white);
  border-color: var(--cat-route);
  box-shadow: 0 4rpx 12rpx rgba(62, 122, 110, 0.25);
}

.days-tab:active { transform: scale(0.96); }

/* === Tag 筛选 === */
.tag-filter-bar {
  margin: 0 var(--space-lg) var(--space-md);
  padding: var(--space-md) var(--space-md) 10rpx;
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
}

.tag-filter-wrap {
  display: flex; flex-wrap: wrap; gap: 10rpx;
  overflow: hidden; max-height: 116rpx;
  transition: max-height 0.25s ease;
}
.tag-filter-wrap.expanded { max-height: 2000rpx; }

.tag-chip {
  flex: none; height: 56rpx; padding: 0 22rpx; line-height: 52rpx;
  font-size: var(--font-xs); color: var(--text-secondary);
  background: var(--bg-muted); border-radius: var(--radius-pill);
  border: 2rpx solid transparent;
  transition: all var(--duration-fast) var(--ease-out);
}
.tag-chip.active {
  background: var(--cat-route); color: var(--text-white); border-color: var(--cat-route);
}

.tag-filter-toggle {
  display: flex; justify-content: center; align-items: center; gap: 6rpx;
  margin-top: 8rpx; padding: 6rpx 0;
  font-size: var(--font-xs); color: var(--cat-route); letter-spacing: 1rpx;
}

.toggle-icon { width: 20rpx; height: 20rpx; transition: transform 200ms var(--ease-out); }
.toggle-icon.up { transform: rotate(180deg); }

.skeleton-wrapper { padding: 0 var(--space-lg); }
.list-area { padding: 0 var(--space-lg); }
.card-list { display: flex; flex-direction: column; gap: var(--space-lg); }

/* === 路线卡片 === */
.route-card {
  background: var(--bg-surface);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: all var(--duration-fast) var(--ease-out);
}
.route-card:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-sm);
}

/* 封面 · 渐变 overlay + 角标 */
.card-cover {
  position: relative;
  width: 100%;
  height: 280rpx;
  background: var(--cat-route-soft);
  overflow: hidden;
}

.cover-fallback {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, var(--cat-route-soft) 0%, var(--bg-muted) 100%);
}

.fallback-icon {
  width: 120rpx; height: 120rpx;
  opacity: 0.5;
}

.cover-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 30%, rgba(0,0,0,0.35) 100%);
  pointer-events: none;
}

.cover-badge {
  position: absolute;
  bottom: 20rpx; left: 24rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8rpx);
  border-radius: var(--radius-pill);
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--cat-route);
  letter-spacing: 0.5rpx;
}

.badge-dot { opacity: 0.4; }

/* 卡片正文 */
.card-body {
  padding: var(--space-lg);
}

.route-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
  line-height: 1.3;
  margin-bottom: var(--space-md);
}

/* meta-row · 距离/时长/方式 chip */
.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: var(--space-md);
}

.meta-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  background: var(--bg-muted);
  border-radius: var(--radius-pill);
  font-size: var(--font-xs);
  color: var(--text-secondary);
  font-variant-numeric: tabular-nums;
}

.meta-icon { width: 22rpx; height: 22rpx; }

.meta-chip-transport {
  background: var(--cat-route-soft);
  color: var(--cat-route);
  font-weight: 600;
}

/* SVG 缩略路径 */
.trail-thumb {
  margin: var(--space-sm) 0 var(--space-md);
  padding: 12rpx 16rpx;
  background: var(--bg-muted);
  border-radius: var(--radius-md);
  position: relative;
}

.trail-svg {
  display: block;
  width: 100%;
  height: 80rpx;
}

.route-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.55;
  margin-bottom: var(--space-md);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.route-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: var(--space-md);
}

.card-cta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  padding-top: var(--space-md);
  border-top: 2rpx solid var(--divider-color);
  font-size: var(--font-sm);
  color: var(--cat-route);
  font-weight: 500;
}

.cta-arrow {
  width: 24rpx;
  height: 24rpx;
}

/* === 内容声明条:把"路线"定位为玩法分享(避旅游服务类目) === */
.ugc-disclaimer {
  margin: 0 var(--space-lg) var(--space-md);
  padding: 14rpx 20rpx;
  background: rgba(30, 82, 102, 0.06);
  border-left: 4rpx solid var(--cat-route, #1E5266);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: var(--font-xs);
  color: #5A6B73;
  line-height: 1.55;
}

.ugc-disclaimer-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.ugc-disclaimer-text {
  flex: 1;
}
