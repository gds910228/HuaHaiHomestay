/* pages/admin/guide-edit/index.wxss */
.edit-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.form-section {
  padding: 30rpx;
}

.form-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.picker-value {
  font-size: 28rpx;
  color: #333;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* ============ 标签 ============ */
.tag-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  background: #f0f4ff;
  font-size: 24rpx;
  color: #2E7DFF;
  line-height: 1.4;
  border: 2rpx solid transparent;
}

.tag-chip.selected {
  background: #2E7DFF;
  color: #fff;
}

.tag-chip.cloud {
  background: #f5f5f5;
  color: #666;
  border: 2rpx solid #eee;
}

.tag-chip.cloud.selected {
  background: #2E7DFF;
  color: #fff;
  border-color: #2E7DFF;
}

.tag-chip-text {
  font-size: 24rpx;
}

.tag-chip-close {
  margin-left: 10rpx;
  font-size: 28rpx;
  line-height: 1;
}

.tag-chip-count {
  margin-left: 6rpx;
  font-size: 20rpx;
  opacity: 0.7;
}

.tag-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tag-input {
  flex: 1;
}

.tag-add-btn {
  flex: none;
  padding: 0 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #2E7DFF;
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.tag-cloud-label {
  display: block;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* ============ 图片上传 ============ */
.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.uploaded-images {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.upload-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.upload-icon {
  font-size: 60rpx;
  color: #999;
  line-height: 1;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

/* ============ 富文本编辑器 ============ */
.editor-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 12rpx;
  background: #fafafa;
  border-radius: 8rpx;
}

.tb-btn {
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 14rpx;
  line-height: 56rpx;
  text-align: center;
  background: #fff;
  border: 2rpx solid #eaeaea;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.tb-btn.active {
  background: #2E7DFF;
  color: #fff;
  border-color: #2E7DFF;
}

.tb-btn.primary {
  background: #2E7DFF;
  color: #fff;
  border-color: #2E7DFF;
}

.tb-btn.danger {
  color: #e64340;
  border-color: #fbd5d4;
}

.tb-bold { font-weight: bold; }
.tb-italic { font-style: italic; }
.tb-underline { text-decoration: underline; }

.rich-editor {
  width: 100%;
  min-height: 460rpx;
  padding: 20rpx;
  background: #fff;
  border: 2rpx solid #eaeaea;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

/* ============ 底部按钮 ============ */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #2E7DFF 0%, #1E5FD4 100%);
  color: #fff;
}
