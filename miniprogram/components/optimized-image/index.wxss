/* components/optimized-image/index.wxss */
.optimized-image-container {
  position: relative;
  overflow: hidden;
  background: var(--bg-muted);
  border-radius: var(--radius-md);
}

.optimized-image {
  width: 100%;
  height: 100%;
  display: block;
  opacity: 0;
  transition: opacity var(--duration-normal) var(--ease-default);
}

.optimized-image.loaded {
  opacity: 1;
}

.optimized-image.loading {
  opacity: 0;
}

.optimized-image.error {
  display: none;
}

/* 加载占位 */
.image-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-muted);
}

.placeholder-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border-line);
  border-top-color: var(--brand-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 错误占位 */
.image-error {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-muted);
  gap: var(--space-sm);
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.65;
}

.error-text {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
}

/* 提示徽章 */
.image-badge {
  position: absolute;
  bottom: var(--space-md);
  right: var(--space-md);
  padding: 6rpx 16rpx;
  background: rgba(30, 56, 72, 0.72);
  backdrop-filter: blur(10rpx);
  border-radius: var(--radius-pill);
}

.badge-text {
  font-size: var(--font-xs);
  color: var(--text-white);
  letter-spacing: 0.5rpx;
}

/* 不同模式 */
.optimized-image-container.aspectFill {
  display: block;
}

.optimized-image-container.aspectFit {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-muted);
}

.optimized-image-container.widthFix {
  height: auto !important;
}
