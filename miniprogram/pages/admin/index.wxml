<!--pages/admin/index.wxml-->
<view class="admin-container">
  <!-- 未登录 -->
  <view class="login-section" wx:if="{{!isAdmin}}">
    <view class="login-card">
      <image class="app-logo-image" src="/images/logo.jpg" mode="aspectFit"></image>
      <view class="login-eyebrow">ADMIN</view>
      <text class="login-title">管理后台</text>
      <text class="login-desc">请登录以管理画海民宿的内容</text>
      <button class="login-btn btn-primary" bindtap="login">登录</button>
    </view>
  </view>

  <!-- 已登录 -->
  <view class="admin-content" wx:if="{{isAdmin}}">
    <view class="welcome-card">
      <view class="welcome-eyebrow">WELCOME · 欢迎回来</view>
      <text class="welcome-title">管理画海内容</text>
      <text class="welcome-desc">攻略、房型、设施一键维护</text>
    </view>

    <view class="menu-list">
      <view class="menu-card clickable" bindtap="goToGuides">
        <view class="menu-icon-wrap menu-icon-brand">
          <image class="menu-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231E5266' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 20 h 9'/%3E%3Cpath d='M16.5 3.5 a 2.121 2.121 0 0 1 3 3 L 7 19 l -4 1 1 -4 12.5 -12.5 z'/%3E%3C/svg%3E" mode="aspectFit"></image>
        </view>
        <view class="menu-info">
          <text class="menu-title">攻略管理</text>
          <text class="menu-desc">景点 · 美食 · 路线 · 信息</text>
        </view>
        <image class="menu-arrow" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23A39A8D' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M9 6 l 6 6 -6 6'/%3E%3C/svg%3E" mode="aspectFit"></image>
      </view>

      <view class="menu-card clickable" bindtap="goToHostel">
        <view class="menu-icon-wrap menu-icon-accent">
          <image class="menu-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23C76F4E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M3 9 l 9 -7 9 7 v 11 a 2 2 0 0 1 -2 2 H 5 a 2 2 0 0 1 -2 -2 z'/%3E%3Cpath d='M9 22 V 12 h 6 v 10'/%3E%3C/svg%3E" mode="aspectFit"></image>
        </view>
        <view class="menu-info">
          <text class="menu-title">民宿信息</text>
          <text class="menu-desc">基本信息 · 房型 · 设施</text>
        </view>
        <image class="menu-arrow" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23A39A8D' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M9 6 l 6 6 -6 6'/%3E%3C/svg%3E" mode="aspectFit"></image>
      </view>
    </view>

    <view class="logout-section">
      <button class="logout-btn btn-secondary" bindtap="logout">退出登录</button>
    </view>
  </view>
</view>
