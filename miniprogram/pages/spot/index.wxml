<!--pages/spot/index.wxml-->
<view class="cat-page cat-spot">
  <view class="cat-hero">
    <image class="hero-deco" src="/images/icons/deco-spot-white.svg" mode="aspectFit"></image>
    <view class="hero-bubble bubble-1"></view>
    <view class="hero-bubble bubble-2"></view>
    <view class="hero-bubble bubble-3"></view>
    <view class="hero-spark spark-1"></view>
    <view class="hero-spark spark-2"></view>
    <view class="hero-spark spark-3"></view>
    <view class="hero-glow"></view>
    <view class="hero-meta">
      <view class="hero-eyebrow">SPOT · 景点打卡</view>
      <view class="hero-title">必去之地</view>
      <view class="hero-sub">在南澳岛拍下你的封面</view>
    </view>
  </view>

  <!-- 定位授权条 -->
  <view class="location-banner {{hasLocation ? 'on' : ''}}">
    <view wx:if="{{!hasLocation}}" class="loc-call">
      <image class="loc-icon" src="/images/icons/pin.svg" mode="aspectFit"></image>
      <text class="loc-text">开启定位,按距离排序</text>
      <view class="loc-btn" bindtap="requestLocation">开启</view>
    </view>
    <view wx:else class="loc-on">
      <image class="loc-icon" src="/images/icons/pin.svg" mode="aspectFit"></image>
      <text class="loc-text">已定位 · 共 {{guides.length}} 个景点</text>
      <view class="loc-refresh" bindtap="requestLocation">重新定位</view>
    </view>
  </view>

  <!-- 天气筛选 -->
  <view class="weather-filter-bar" wx:if="{{guides.length > 0 && playableCount > 0}}">
    <view class="wf-chip {{weatherFilter ? 'active' : ''}}" bindtap="toggleWeatherFilter">
      <text class="wf-emoji">🌤</text>
      <text class="wf-text">现在适合玩</text>
      <text class="wf-count">{{playableCount}}</text>
    </view>
  </view>

  <view class="tag-filter-bar" wx:if="{{tagOptions.length > 0}}">
    <view class="tag-filter-wrap {{tagsExpanded ? 'expanded' : 'collapsed'}}">
      <view class="tag-chip {{activeTag === '' ? 'active' : ''}}" data-tag="" bindtap="selectTag">全部</view>
      <view
        class="tag-chip {{activeTag === item.name ? 'active' : ''}}"
        wx:for="{{tagOptions}}"
        wx:key="name"
        data-tag="{{item.name}}"
        bindtap="selectTag"
      >{{item.name}}</view>
    </view>
    <view class="tag-filter-toggle clickable" bindtap="toggleTagsExpanded" wx:if="{{tagOptions.length > 8}}">
      <text>{{tagsExpanded ? '收起' : '展开'}}</text>
      <image class="toggle-icon {{tagsExpanded ? 'up' : ''}}" src="/images/icons/chevron-down.svg" mode="aspectFit"></image>
    </view>
  </view>

  <loading-state wx:if="{{loading && !isFirstLoad}}" text="正在加载..."></loading-state>

  <view class="skeleton-wrapper" wx:if="{{loading && isFirstLoad}}">
    <skeleton-card wx:for="{{[1,2,3]}}" wx:key="*this"></skeleton-card>
  </view>

  <!-- 错误态 -->
  <view class="error-block" wx:if="{{!loading && errorMsg}}">
    <image class="error-icon" src="/images/icons/info.svg" mode="aspectFit"></image>
    <text class="error-text">{{errorMsg}}</text>
    <view class="error-btn" bindtap="retry">重新加载</view>
  </view>

  <empty-state
    wx:if="{{!loading && !errorMsg && guides.length === 0}}"
    title="暂无{{category.name}}"
    description="管理员正在努力添加中..."
    actionText="返回首页"
    bind:action="goHome"
  ></empty-state>

  <view class="list-area" wx:if="{{!loading && filteredGuides.length > 0}}">
    <view class="card-list">
      <view
        class="guide-card fade-in-up clickable {{guide.playable && weatherFilter ? 'playable' : ''}}"
        wx:for="{{filteredGuides}}"
        wx:key="_id"
        wx:for-item="guide"
        style="animation-delay: {{index * 60}}ms"
        data-id="{{guide._id}}"
        bindtap="viewGuide"
      >
        <!-- 天气徽章 -->
        <view class="weather-badge" wx:if="{{guide.weatherBrief}}">
          <image wx:if="{{guide.weatherBrief.iconUrl}}" class="wb-icon" src="{{guide.weatherBrief.iconUrl}}" mode="aspectFit"></image>
          <text class="wb-temp">{{guide.weatherBrief.temp}}</text>
        </view>

        <optimized-image
          wx:if="{{guide.hasRealImage}}"
          class="guide-image"
          src="{{guide.images[0]}}"
          width="100%"
          height="340rpx"
          mode="aspectFill"
          badge="{{guide.images.length}}"
          catchtap="previewImage"
          data-url="{{guide.images[0]}}"
          data-images="{{guide.images}}"
        ></optimized-image>

        <view wx:if="{{!guide.hasRealImage}}" class="guide-no-image">
          <image class="no-image-icon" src="/images/icons/pin.svg" mode="aspectFit"></image>
          <text class="no-image-text">暂无图片</text>
        </view>

        <view class="guide-info">
          <text class="guide-title">{{guide.title}}</text>

          <view class="guide-address" wx:if="{{guide.address}}">
            <image class="addr-icon" src="/images/icons/pin.svg" mode="aspectFit"></image>
            <text class="addr-text text-ellipsis">{{guide.address}}</text>
          </view>

          <view class="guide-tags" wx:if="{{guide.tags && guide.tags.length > 0}}">
            <view class="tag tag-spot" wx:for="{{guide.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</view>
          </view>

          <text class="guide-desc text-clamp-2" wx:if="{{guide.summary}}">{{guide.summary}}</text>

          <!-- 距离行 -->
          <view class="distance-row" wx:if="{{guide.distanceDisplay}}">
            <image class="dist-icon" src="/images/icons/pin.svg" mode="aspectFit"></image>
            <text class="dist-text">{{guide.distanceDisplay.text}}</text>
          </view>

          <view class="guide-actions">
            <button
              class="action-btn nav-btn"
              data-latitude="{{guide.location && guide.location.latitude}}"
              data-longitude="{{guide.location && guide.location.longitude}}"
              data-title="{{guide.title}}"
              data-address="{{guide.address}}"
              catchtap="navigate"
            >
              <image class="action-icon" src="/images/icons/pin-white.svg" mode="aspectFit"></image>
              <text>导航</text>
            </button>
            <button
              class="action-btn fav-btn {{guide.isFavorited ? 'favorited' : ''}}"
              data-id="{{guide._id}}"
              catchtap="toggleFavorite"
            >
              <image wx:if="{{guide.isFavorited}}" class="action-icon" src="/images/icons/heart-filled.svg" mode="aspectFit"></image>
              <image wx:else class="action-icon" src="/images/icons/heart.svg" mode="aspectFit"></image>
              <text>{{guide.isFavorited ? '已收藏' : '收藏'}}</text>
            </button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- weatherFilter 激活但无结果 -->
  <view class="empty-soft" wx:if="{{!loading && weatherFilter && guides.length > 0 && filteredGuides.length === 0}}">
    <text>当前没有适合玩的景点 · 试试取消筛选</text>
  </view>
</view>
