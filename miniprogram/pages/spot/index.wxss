/* pages/spot/index.wxss · 景点打卡 · 深海青 (主品牌色) */
.cat-page {
  min-height: 100vh;
  background: var(--bg-canvas);
  padding-bottom: 80rpx;
}

.cat-hero {
  padding: var(--space-2xl) var(--space-xl) var(--space-xl);
  background: var(--cat-spot);
  color: var(--text-white);
}

.hero-eyebrow {
  font-size: var(--font-xs);
  letter-spacing: 4rpx;
  opacity: 0.85;
  font-weight: 500;
  margin-bottom: var(--space-xs);
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.15;
  margin-bottom: 6rpx;
}

.hero-sub {
  font-size: var(--font-sm);
  opacity: 0.82;
  letter-spacing: 0.5rpx;
}

.tag-filter-bar {
  position: relative;
  margin: -32rpx var(--space-lg) var(--space-md);
  padding: var(--space-md) var(--space-md) 10rpx;
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  z-index: 2;
}

.tag-filter-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  overflow: hidden;
  max-height: 116rpx;
  transition: max-height 0.25s ease;
}

.tag-filter-wrap.expanded { max-height: 2000rpx; }

.tag-chip {
  flex: none;
  height: 56rpx;
  padding: 0 22rpx;
  line-height: 52rpx;
  font-size: var(--font-xs);
  color: var(--text-secondary);
  background: var(--bg-muted);
  border-radius: var(--radius-pill);
  border: 2rpx solid transparent;
  transition: all var(--duration-fast) var(--ease-out);
}

.tag-chip.active {
  background: var(--cat-spot);
  color: var(--text-white);
  border-color: var(--cat-spot);
}

.tag-filter-toggle {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
  padding: 6rpx 0;
  font-size: var(--font-xs);
  color: var(--cat-spot);
  letter-spacing: 1rpx;
}

.toggle-icon { width: 20rpx; height: 20rpx; transition: transform 200ms var(--ease-out); }
.toggle-icon.up { transform: rotate(180deg); }

.skeleton-wrapper { padding: 0 var(--space-lg); }
.list-area { padding: 0 var(--space-lg); }

.card-list { display: flex; flex-direction: column; gap: var(--space-lg); }

.guide-card {
  background: var(--bg-surface);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: all var(--duration-fast) var(--ease-out);
}

.guide-card:active { transform: scale(0.99); box-shadow: var(--shadow-sm); }

.guide-no-image {
  width: 100%;
  height: 240rpx;
  background: var(--cat-spot-soft);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.no-image-icon { width: 64rpx; height: 64rpx; opacity: 0.75; }
.no-image-text { font-size: var(--font-xs); color: var(--cat-spot); letter-spacing: 1rpx; }

.guide-info { padding: var(--space-lg); }

.guide-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
  line-height: 1.35;
  margin-bottom: var(--space-sm);
}

.guide-address { display: flex; align-items: center; gap: 6rpx; margin-bottom: var(--space-sm); }
.addr-icon { width: 24rpx; height: 24rpx; flex-shrink: 0; }
.addr-text { flex: 1; font-size: var(--font-xs); color: var(--text-secondary); }
.guide-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: var(--space-sm); }

.guide-desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: var(--font-sm);
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: var(--space-md);
}

.guide-actions {
  display: flex;
  gap: 12rpx;
  padding-top: var(--space-md);
  border-top: 2rpx solid var(--divider-color);
}

.action-btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 72rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-sm);
  font-weight: 500;
  padding: 0 16rpx;
  transition: all var(--duration-fast) var(--ease-out);
}

.action-btn:active { transform: scale(0.96); }

.nav-btn { background: var(--brand-primary); color: var(--text-white); }

.fav-btn {
  background: var(--bg-muted);
  color: var(--cat-spot);
  border: 2rpx solid var(--cat-spot-soft);
}

.fav-btn.favorited {
  background: var(--cat-spot);
  color: var(--text-white);
  border-color: var(--cat-spot);
}

.action-icon { width: 26rpx; height: 26rpx; }
