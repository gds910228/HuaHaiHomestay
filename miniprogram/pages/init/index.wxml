<!--pages/init/index.wxml-->
<view class="init-container" wx:if="{{verified}}">
  <!-- 标题卡片 -->
  <view class="header-card">
    <text class="app-logo">🏡 画海民宿</text>
    <text class="app-desc">数据管理工具</text>
  </view>

  <!-- 操作区域 -->
  <view class="actions-section">

    <!-- 快速初始化 -->
    <view class="action-group">
      <text class="group-title">📦 快速初始化</text>
      <button
        class="action-btn primary"
        bindtap="initAll"
        disabled="{{loading}}"
      >
        <text>初始化全部数据（首次使用）</text>
      </button>
    </view>

    <!-- 房型管理 -->
    <view class="action-group">
      <text class="group-title">🛏️ 房型管理</text>
      <view class="button-grid">
        <button
          class="grid-btn secondary"
          bindtap="addLingFengRoom"
          disabled="{{loading}}"
        >
          <text class="btn-emoji">🌊</text>
          <text class="btn-text">聆风</text>
          <text class="btn-subtext">一室</text>
        </button>
        <button
          class="grid-btn secondary"
          bindtap="addWangHaiRoom"
          disabled="{{loading}}"
        >
          <text class="btn-emoji">🏖️</text>
          <text class="btn-text">望海</text>
          <text class="btn-subtext">二室</text>
        </button>
        <button
          class="grid-btn secondary"
          bindtap="addSanFangRoom"
          disabled="{{loading}}"
        >
          <text class="btn-emoji">🏡</text>
          <text class="btn-text">三房</text>
          <text class="btn-subtext">三室</text>
        </button>
      </view>
      <button
        class="full-btn secondary"
        bindtap="updateRoomFacilities"
        disabled="{{loading}}"
      >
        <text>🔧 更新所有房型设施数据</text>
      </button>
    </view>

    <!-- 内容管理 -->
    <view class="action-group">
      <text class="group-title">📚 内容管理</text>
      <button
        class="full-btn secondary"
        bindtap="initFood"
        disabled="{{loading}}"
      >
        <text>🍴 导入美食攻略（真实数据）</text>
      </button>
    </view>

    <!-- 数据维护 -->
    <view class="action-group danger-group">
      <text class="group-title">⚠️ 数据维护（危险操作）</text>
      <view class="button-row">
        <button
          class="half-btn warning"
          bindtap="clearRooms"
          disabled="{{loading}}"
        >
          <text>清空房型</text>
        </button>
        <button
          class="half-btn"
          bindtap="clearAll"
          disabled="{{loading}}"
        >
          <text>清空全部</text>
        </button>
      </view>
    </view>

    <!-- 快捷入口 -->
    <view class="action-group">
      <text class="group-title">🔗 快捷入口</text>
      <view class="button-row">
        <button
          class="half-btn secondary"
          bindtap="goToAdmin"
          disabled="{{loading}}"
        >
          <text>⚙️ 管理后台</text>
        </button>
        <button
          class="half-btn secondary"
          bindtap="goToAdminGuides"
          disabled="{{loading}}"
        >
          <text>📝 编辑攻略</text>
        </button>
      </view>
    </view>

  </view>

  <!-- 执行日志 -->
  <view class="logs-section card">
    <view class="logs-header">
      <text class="logs-title">📋 执行日志</text>
      <view class="logs-actions">
        <text class="logs-count">{{logs.length}} 条</text>
        <text class="clear-logs" bindtap="clearLogs">清空</text>
      </view>
    </view>
    <scroll-view class="logs-content" scroll-y scroll-into-view="log-top">
      <text id="log-top"></text>
      <text class="log-item" wx:for="{{logs}}" wx:key="*this">{{item}}</text>
      <text class="log-empty" wx:if="{{logs.length === 0}}">暂无日志</text>
    </scroll-view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions">
    <button class="home-btn btn-primary" bindtap="goHome">
      <text>🏠 返回首页</text>
    </button>
  </view>
</view>
