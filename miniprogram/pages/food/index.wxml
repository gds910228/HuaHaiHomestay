<!--pages/food/index.wxml-->
<view class="food-container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">🍴 美食推荐</text>
    <text class="page-subtitle">本地人推荐的美食攻略</text>
  </view>

  <!-- 加载状态 -->
  <loading-state wx:if="{{loading}}" text="正在加载美食推荐..."></loading-state>

  <!-- 空状态 -->
  <empty-state
    wx:if="{{!loading && guides.length === 0}}"
    icon="🍽️"
    title="暂无美食推荐"
    description="管理员正在努力添加中..."
    actionText="返回首页"
    bind:action="goHome"
  ></empty-state>

  <!-- 骨架屏（首次加载时显示） -->
  <view class="skeleton-wrapper" wx:if="{{loading && isFirstLoad}}">
    <skeleton-card wx:for="{{[1,2,3]}}" wx:key="*this"></skeleton-card>
  </view>

  <!-- 选项卡 -->
  <view class="tabs-container" wx:if="{{!loading && tabs.length > 0}}">
    <view
      class="tab-item {{currentTab === index ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <text class="tab-icon">{{item.icon}}</text>
      <text class="tab-name">{{item.name}}</text>
      <text class="tab-count">{{item.count}}家</text>
    </view>
  </view>

  <!-- 选项卡内容区域 -->
  <view class="tab-content-area" wx:if="{{!loading && tabs.length > 0}}">
    <view class="food-list">
      <view class="food-item fade-in-up"
             wx:for="{{groupedGuides[tabs[currentTab].key]}}"
             wx:key="_id"
             wx:for-item="guide"
             style="animation-delay: {{index * 100}}ms">
        <view class="food-card {{guide.hasRealImage ? 'has-image' : 'no-image'}} clickable hover-lift">

          <!-- 优化的图片组件 -->
          <optimized-image
            wx:if="{{guide.hasRealImage}}"
            class="food-optimized-image"
            src="{{guide.images[0]}}"
            width="100%"
            height="320rpx"
            mode="aspectFill"
            badge="{{guide.images.length}}张照片"
            bindload="onImageLoad"
            binderror="onImageError"
            bindtap="previewImage"
            data-url="{{guide.images[0]}}"
            data-images="{{guide.images}}"
          ></optimized-image>

          <!-- 无图片时的默认图标 -->
          <view wx:if="{{!guide.hasRealImage}}" class="food-no-image">
            <text class="no-image-icon">🍽️</text>
            <text class="no-image-text">暂无图片</text>
          </view>

          <view class="food-info">
            <text class="food-title">{{guide.title}}</text>
            <text class="food-address" wx:if="{{guide.address}}">📍 {{guide.address}}</text>

            <view class="food-tags" wx:if="{{guide.tags && guide.tags.length > 0}}">
              <text class="food-tag" wx:for="{{guide.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>

            <text class="food-desc" wx:if="{{guide.summary}}">{{guide.summary}}</text>

            <view class="food-actions">
              <button
                  class="nav-btn clickable"
                  data-latitude="{{guide.location && guide.location.latitude}}"
                  data-longitude="{{guide.location && guide.location.longitude}}"
                  data-title="{{guide.title}}"
                  data-address="{{guide.address}}"
                  catchtap="navigate"
                >
                <text>🧭 一键导航</text>
              </button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
