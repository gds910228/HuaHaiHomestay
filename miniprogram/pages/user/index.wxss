/* pages/user/index.wxss */
.user-container {
  min-height: 100vh;
  background: var(--bg-canvas);
  padding-bottom: 80rpx;
}

/* === 用户头部 (沉浸式渐变 sheet) === */
.user-header {
  position: relative;
  padding: 56rpx var(--space-xl) var(--space-2xl);
  background: linear-gradient(160deg, #FBF7F0 0%, #F4EFE6 100%);
  overflow: hidden;
  margin-bottom: var(--space-md);
}

.header-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.header-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
  opacity: 0.55;
}

.blob-1 {
  top: -80rpx;
  right: -40rpx;
  width: 280rpx;
  height: 280rpx;
  background: radial-gradient(circle, rgba(232, 145, 109, 0.55) 0%, transparent 70%);
  animation: blob-float-1 9s ease-in-out infinite;
}

.blob-2 {
  bottom: -100rpx;
  left: -60rpx;
  width: 320rpx;
  height: 320rpx;
  background: radial-gradient(circle, rgba(30, 82, 102, 0.32) 0%, transparent 70%);
  animation: blob-float-2 11s ease-in-out infinite;
}

@keyframes blob-float-1 {
  0%, 100% { transform: translate(0, 0); }
  50%      { transform: translate(-30rpx, 24rpx); }
}

@keyframes blob-float-2 {
  0%, 100% { transform: translate(0, 0); }
  50%      { transform: translate(36rpx, -28rpx); }
}

.user-info {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  margin-right: var(--space-lg);
  background: var(--bg-surface);
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 20rpx rgba(30, 82, 102, 0.12);
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-eyebrow {
  font-size: var(--font-xs);
  letter-spacing: 4rpx;
  color: var(--text-tertiary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
  margin-bottom: 4rpx;
}

.user-desc {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

/* === 区块 === */
.section-block {
  margin-top: var(--space-xl);
}

.section-head {
  padding: 0 var(--space-xl) var(--space-md);
}

.section-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-eyebrow {
  font-size: var(--font-xs);
  letter-spacing: 4rpx;
  color: var(--text-tertiary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.section-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

.section-count {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  font-variant-numeric: tabular-nums;
}

/* === 收藏列表 === */
.favorites-list {
  padding: 0 var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.favorite-card {
  display: flex;
  align-items: center;
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  padding: var(--space-md);
  box-shadow: var(--shadow-sm);
  gap: var(--space-md);
  transition: all var(--duration-fast) var(--ease-out);
}

.favorite-card:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-md);
}

.favorite-image {
  width: 152rpx;
  height: 152rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--bg-muted);
}

.favorite-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-svg {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.65;
}

.favorite-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.favorite-tag-row {
  margin-bottom: 4rpx;
}

.favorite-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.3rpx;
}

.favorite-desc {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

.favorite-remove {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--bg-muted);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all var(--duration-fast) var(--ease-out);
}

.favorite-remove:active {
  background: var(--color-danger-soft);
  transform: scale(0.92);
}

.remove-icon {
  width: 28rpx;
  height: 28rpx;
}

/* === 菜单 === */
.menu-list {
  margin: 0 var(--space-lg);
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  padding: 0 var(--space-xl);
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
}

.menu-item:active {
  background: var(--bg-muted);
  border-radius: var(--radius-md);
  margin: 0 -16rpx;
  padding: 28rpx 16rpx;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon-brand { background: var(--brand-primary-soft); }
.menu-icon-accent { background: var(--brand-accent-soft); }
.menu-icon-muted { background: var(--bg-muted); }

.menu-icon {
  width: 36rpx;
  height: 36rpx;
}

.menu-label {
  font-size: var(--font-lg);
  color: var(--text-primary);
  font-weight: 500;
}

.menu-arrow {
  width: 28rpx;
  height: 28rpx;
}

.menu-divider {
  height: 2rpx;
  background: var(--divider-color);
}
