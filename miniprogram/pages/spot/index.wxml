<!--pages/spot/index.wxml-->
<view class="cat-page cat-spot">
  <view class="cat-hero">
    <view class="hero-eyebrow">SPOT · 景点打卡</view>
    <view class="hero-title">必去之地</view>
    <view class="hero-sub">在南澳岛拍下你的封面</view>
  </view>

  <view class="tag-filter-bar" wx:if="{{tagOptions.length > 0}}">
    <view class="tag-filter-wrap {{tagsExpanded ? 'expanded' : 'collapsed'}}">
      <view class="tag-chip {{activeTag === '' ? 'active' : ''}}" data-tag="" bindtap="selectTag">全部</view>
      <view
        class="tag-chip {{activeTag === item.name ? 'active' : ''}}"
        wx:for="{{tagOptions}}"
        wx:key="name"
        data-tag="{{item.name}}"
        bindtap="selectTag"
      >{{item.name}}</view>
    </view>
    <view class="tag-filter-toggle clickable" bindtap="toggleTagsExpanded" wx:if="{{tagOptions.length > 8}}">
      <text>{{tagsExpanded ? '收起' : '展开'}}</text>
      <image class="toggle-icon {{tagsExpanded ? 'up' : ''}}" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231E5266' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M6 9 l 6 6 6 -6'/%3E%3C/svg%3E" mode="aspectFit"></image>
    </view>
  </view>

  <loading-state wx:if="{{loading && !isFirstLoad}}" text="正在加载..."></loading-state>

  <view class="skeleton-wrapper" wx:if="{{loading && isFirstLoad}}">
    <skeleton-card wx:for="{{[1,2,3]}}" wx:key="*this"></skeleton-card>
  </view>

  <empty-state
    wx:if="{{!loading && guides.length === 0}}"
    title="暂无{{category.name}}"
    description="管理员正在努力添加中..."
    actionText="返回首页"
    bind:action="goHome"
  ></empty-state>

  <view class="list-area" wx:if="{{!loading && guides.length > 0}}">
    <view class="card-list">
      <view
        class="guide-card fade-in-up clickable"
        wx:for="{{guides}}"
        wx:key="_id"
        wx:for-item="guide"
        style="animation-delay: {{index * 60}}ms"
        data-id="{{guide._id}}"
        bindtap="viewGuide"
      >
        <optimized-image
          wx:if="{{guide.hasRealImage}}"
          class="guide-image"
          src="{{guide.images[0]}}"
          width="100%"
          height="340rpx"
          mode="aspectFill"
          badge="{{guide.images.length}}"
          catchtap="previewImage"
          data-url="{{guide.images[0]}}"
          data-images="{{guide.images}}"
        ></optimized-image>

        <view wx:if="{{!guide.hasRealImage}}" class="guide-no-image">
          <image class="no-image-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231E5266' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 22 s -7 -7 -7 -13 a 7 7 0 0 1 14 0 c 0 6 -7 13 -7 13 z'/%3E%3Ccircle cx='12' cy='9' r='2.4'/%3E%3C/svg%3E" mode="aspectFit"></image>
          <text class="no-image-text">暂无图片</text>
        </view>

        <view class="guide-info">
          <text class="guide-title">{{guide.title}}</text>

          <view class="guide-address" wx:if="{{guide.address}}">
            <image class="addr-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23A39A8D' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M12 22 s -7 -7 -7 -13 a 7 7 0 0 1 14 0 c 0 6 -7 13 -7 13 z'/%3E%3Ccircle cx='12' cy='9' r='2.4'/%3E%3C/svg%3E" mode="aspectFit"></image>
            <text class="addr-text text-ellipsis">{{guide.address}}</text>
          </view>

          <view class="guide-tags" wx:if="{{guide.tags && guide.tags.length > 0}}">
            <view class="tag tag-spot" wx:for="{{guide.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</view>
          </view>

          <text class="guide-desc text-clamp-2" wx:if="{{guide.summary}}">{{guide.summary}}</text>

          <view class="guide-actions">
            <button
              class="action-btn nav-btn"
              data-latitude="{{guide.location && guide.location.latitude}}"
              data-longitude="{{guide.location && guide.location.longitude}}"
              data-title="{{guide.title}}"
              data-address="{{guide.address}}"
              catchtap="navigate"
            >
              <image class="action-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23FFFFFF' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpolygon points='3 11 22 2 13 21 11 13 3 11'/%3E%3C/svg%3E" mode="aspectFit"></image>
              <text>导航</text>
            </button>
            <button
              class="action-btn fav-btn {{guide.isFavorited ? 'favorited' : ''}}"
              data-id="{{guide._id}}"
              catchtap="toggleFavorite"
            >
              <image wx:if="{{guide.isFavorited}}" class="action-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23FFFFFF' stroke='%23FFFFFF' stroke-width='1.6'%3E%3Cpath d='M20.84 4.61 a 5.5 5.5 0 0 0 -7.78 0 L 12 5.67 l -1.06 -1.06 a 5.5 5.5 0 0 0 -7.78 7.78 l 1.06 1.06 L 12 21.23 l 7.78 -7.78 1.06 -1.06 a 5.5 5.5 0 0 0 0 -7.78 z'/%3E%3C/svg%3E" mode="aspectFit"></image>
              <image wx:else class="action-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%231E5266' stroke-width='2'%3E%3Cpath d='M20.84 4.61 a 5.5 5.5 0 0 0 -7.78 0 L 12 5.67 l -1.06 -1.06 a 5.5 5.5 0 0 0 -7.78 7.78 l 1.06 1.06 L 12 21.23 l 7.78 -7.78 1.06 -1.06 a 5.5 5.5 0 0 0 0 -7.78 z'/%3E%3C/svg%3E" mode="aspectFit"></image>
              <text>{{guide.isFavorited ? '已收藏' : '收藏'}}</text>
            </button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
