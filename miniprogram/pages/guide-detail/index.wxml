<!--pages/guide-detail/index.wxml-->
<view class="detail-container" wx:if="{{!loading && guide}}">
  <!-- 顶部图片轮播 -->
  <view class="detail-images">
    <swiper class="images-swiper" indicator-dots="{{guide.images.length > 1}}" indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#FFFFFF" autoplay circular>
      <swiper-item wx:for="{{guide.images}}" wx:key="*this">
        <image
          class="detail-image"
          src="{{item}}"
          mode="aspectFill"
          data-url="{{item}}"
          data-urls="{{guide.images}}"
          bindtap="previewImage"
        ></image>
      </swiper-item>
    </swiper>
    <view class="images-tint"></view>
  </view>

  <!-- 内容 sheet (上凸) -->
  <view class="detail-content">
    <!-- 类目 + 收藏 -->
    <view class="detail-header">
      <view class="header-left">
        <view class="detail-category">{{guide.categoryName}}</view>
        <text class="detail-title">{{guide.title}}</text>
      </view>
      <view class="action-fab {{isFavorite ? 'fav-active' : ''}}" bindtap="toggleFavorite">
        <image
          wx:if="{{isFavorite}}"
          class="fav-icon"
          src="/images/icons/heart-filled.svg"
          mode="aspectFit"
        ></image>
        <image
          wx:else
          class="fav-icon"
          src="/images/icons/heart.svg"
          mode="aspectFit"
        ></image>
      </view>
    </view>

    <!-- 标签 -->
    <view class="detail-tags" wx:if="{{guide.tags && guide.tags.length > 0}}">
      <view class="tag tag-brand" wx:for="{{guide.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</view>
    </view>

    <!-- 统计信息 -->
    <view class="detail-stats">
      <view class="stat-item">
        <image class="stat-icon" src="/images/icons/eye.svg" mode="aspectFit"></image>
        <text class="stat-value tabular-nums">{{guide.views || 0}}</text>
      </view>
      <view class="stat-item" wx:if="{{guide.likes > 0}}">
        <image class="stat-icon" src="/images/icons/heart-filled.svg" mode="aspectFit"></image>
        <text class="stat-value tabular-nums">{{guide.likes || 0}}</text>
      </view>
    </view>

    <!-- 分割线 -->
    <view class="divider"></view>

    <!-- 详细内容 -->
    <view class="detail-body">
      <view class="body-section-eyebrow">DETAILS · 详细介绍</view>
      <rich-text class="body-content" nodes="{{guide.content}}"></rich-text>
    </view>

    <!-- 实用信息 -->
    <view class="detail-info" wx:if="{{guide.info}}">
      <view class="body-section-eyebrow">INFO · 实用信息</view>
      <view class="info-item" wx:for="{{guide.info}}" wx:key="label">
        <text class="info-label">{{item.label}}</text>
        <text class="info-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="detail-footer">
    <button class="footer-btn footer-btn-secondary" open-type="share">
      <image class="footer-btn-icon" src="/images/icons/share.svg" mode="aspectFit"></image>
      <text>分享</text>
    </button>
    <button class="footer-btn footer-btn-primary" bindtap="navigate" wx:if="{{guide.location}}">
      <image class="footer-btn-icon" src="/images/icons/pin-white.svg" mode="aspectFit"></image>
      <text>一键导航</text>
    </button>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-container" wx:if="{{loading}}">
  <loading-state text="正在加载攻略..."></loading-state>
</view>
