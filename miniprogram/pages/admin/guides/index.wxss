/* pages/admin/guides/index.wxss */
.guides-container {
  min-height: 100vh;
  background: var(--bg-canvas);
  padding-bottom: 120rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--bg-surface);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.filter-picker {
  flex: 1;
  height: 64rpx;
  background: var(--bg-canvas);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.picker-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.picker-arrow {
  width: 24rpx;
  height: 24rpx;
}

/* 攻略列表 */
.guides-list {
  padding: 24rpx;
}

.guide-item {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.item-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-right: 16rpx;
}

.item-status {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.item-status.published {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.item-status.draft {
  background: var(--brand-accent-soft);
  color: var(--color-warning);
}

.item-info {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.info-tag {
  padding: 6rpx 16rpx;
  background: var(--brand-primary-soft);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--brand-primary);
}

.info-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.item-actions {
  display: flex;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider-color);
}

.action-btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 26rpx;
  padding: 0;
}

.action-btn.edit {
  background: var(--brand-primary-soft);
  color: var(--brand-primary);
}

.action-btn.toggle {
  background: var(--brand-accent-soft);
  color: var(--color-warning);
}

.action-btn.delete {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* 添加按钮 */
.add-btn {
  position: fixed;
  right: 32rpx;
  bottom: 100rpx;
  width: 112rpx;
  height: 112rpx;
  background: var(--brand-primary);
  border-radius: 56rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 82, 102, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.add-icon {
  font-size: 64rpx;
  color: var(--bg-surface);
  font-weight: 300;
}
