/* components/empty-state/index.wxss */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-2xl) var(--space-xl);
  min-height: 400rpx;
}

.empty-icon {
  margin-bottom: var(--space-lg);
}

.empty-emoji-fallback {
  font-size: 96rpx;
  display: block;
  opacity: 0.55;
}

.empty-image,
.empty-svg {
  width: 200rpx;
  height: 200rpx;
  display: block;
}

.empty-svg-wrap {
  width: 200rpx;
  height: 200rpx;
  opacity: 0.94;
}

.empty-title {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
  text-align: center;
  letter-spacing: -0.5rpx;
}

.empty-desc {
  font-size: var(--font-base);
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: var(--space-xl);
  max-width: 500rpx;
}

.empty-action {
  margin-top: var(--space-lg);
}

.action-btn {
  min-width: 240rpx;
}

/* 简洁型 */
.empty-state.type-simple {
  padding: var(--space-xl);
  min-height: auto;
}

.empty-state.type-simple .empty-svg-wrap,
.empty-state.type-simple .empty-image {
  width: 140rpx;
  height: 140rpx;
}

.empty-state.type-simple .empty-emoji-fallback {
  font-size: 64rpx;
}

.empty-state.type-simple .empty-title {
  font-size: var(--font-lg);
}
