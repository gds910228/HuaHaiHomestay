<!--pages/route/index.wxml-->
<view class="cat-page cat-route">
  <view class="cat-hero">
    <image class="hero-deco" src="/images/icons/deco-route-white.svg" mode="aspectFit"></image>
    <view class="hero-bubble bubble-1"></view>
    <view class="hero-bubble bubble-2"></view>
    <view class="hero-bubble bubble-3"></view>
    <view class="hero-spark spark-1"></view>
    <view class="hero-spark spark-2"></view>
    <view class="hero-spark spark-3"></view>
    <view class="hero-glow"></view>
    <view class="hero-meta">
      <view class="hero-eyebrow">PLAY · 南澳玩法</view>
      <view class="hero-title">环岛慢行</view>
      <view class="hero-sub">从日出礁石到落日海堤</view>
    </view>
  </view>

  <!-- 离线提示条 -->
  <view class="offline-banner" wx:if="{{isOffline}}">
    <text class="offline-dot">●</text>
    <text>当前为离线数据,下拉刷新重试</text>
  </view>

  <!-- 内容声明:把"路线"定位成主理人分享的玩法,而非旅游服务 -->
  <view class="ugc-disclaimer">
    <text class="ugc-disclaimer-icon">📖</text>
    <text class="ugc-disclaimer-text">行程由「画海」整理分享,仅供玩法参考,不提供代订代办服务。</text>
  </view>

  <!-- Day tab -->
  <view class="days-tab-bar">
    <view
      class="days-tab {{activeDays === item.key ? 'active' : ''}}"
      wx:for="{{daysTabs}}"
      wx:key="key"
      data-days="{{item.key}}"
      bindtap="selectDays"
    >{{item.label}}</view>
  </view>

  <!-- 标签筛选 -->
  <view class="tag-filter-bar" wx:if="{{tagOptions.length > 0}}">
    <view class="tag-filter-wrap {{tagsExpanded ? 'expanded' : 'collapsed'}}">
      <view class="tag-chip {{activeTag === '' ? 'active' : ''}}" data-tag="" bindtap="selectTag">全部</view>
      <view
        class="tag-chip {{activeTag === item.name ? 'active' : ''}}"
        wx:for="{{tagOptions}}"
        wx:key="name"
        data-tag="{{item.name}}"
        bindtap="selectTag"
      >{{item.name}}</view>
    </view>
    <view class="tag-filter-toggle clickable" bindtap="toggleTagsExpanded" wx:if="{{tagOptions.length > 8}}">
      <text>{{tagsExpanded ? '收起' : '展开'}}</text>
      <image class="toggle-icon {{tagsExpanded ? 'up' : ''}}" src="/images/icons/chevron-down.svg" mode="aspectFit"></image>
    </view>
  </view>

  <loading-state wx:if="{{loading && !isFirstLoad}}" text="正在加载..."></loading-state>

  <view class="skeleton-wrapper" wx:if="{{loading && isFirstLoad}}">
    <skeleton-card wx:for="{{[1,2,3]}}" wx:key="*this"></skeleton-card>
  </view>

  <empty-state
    wx:if="{{!loading && filtered.length === 0}}"
    title="暂无玩法"
    description="切换 day 或清除标签筛选试试"
    actionText="返回首页"
    bind:action="goHome"
  ></empty-state>

  <view class="list-area" wx:if="{{!loading && filtered.length > 0}}">
    <view class="card-list">
      <view
        class="route-card fade-in-up clickable"
        wx:for="{{filtered}}"
        wx:key="_id"
        wx:for-item="guide"
        style="animation-delay: {{index * 60}}ms"
        data-id="{{guide._id}}"
        bindtap="viewGuide"
      >
        <!-- 封面图 / 占位 -->
        <view class="card-cover">
          <optimized-image
            wx:if="{{guide.hasRealImage}}"
            src="{{guide.coverImage}}"
            width="100%"
            height="280rpx"
            mode="aspectFill"
          ></optimized-image>
          <view wx:if="{{!guide.hasRealImage}}" class="cover-fallback">
            <image class="fallback-icon" src="/images/icons/deco-route-white.svg" mode="aspectFit"></image>
          </view>
          <view class="cover-overlay"></view>

          <!-- 卡片角标 · days + 点位数 -->
          <view class="cover-badge">
            <text class="badge-days">{{guide.daysLabel}}</text>
            <text class="badge-dot">·</text>
            <text class="badge-stops">{{guide.waypointCount}} 站</text>
          </view>
        </view>

        <view class="card-body">
          <text class="route-title">{{guide.title}}</text>

          <!-- 元信息行 · 距离 / 时长 / 交通方式 -->
          <view class="meta-row">
            <view class="meta-chip" wx:if="{{guide.durationDisplay}}">
              <image class="meta-icon" src="/images/icons/clock.svg" mode="aspectFit"></image>
              <text>{{guide.durationDisplay}}</text>
            </view>
            <view class="meta-chip" wx:if="{{guide.distanceDisplay}}">
              <image class="meta-icon" src="/images/icons/route.svg" mode="aspectFit"></image>
              <text>{{guide.distanceDisplay}}</text>
            </view>
            <view class="meta-chip meta-chip-transport">
              <text>{{guide.transportLabel}}</text>
            </view>
          </view>

          <!-- SVG 缩略路径(预览路线轮廓,精度有损,详情页 map 才是准确路径) -->
          <view class="trail-thumb" wx:if="{{guide.miniTrailSrc}}">
            <image class="trail-svg" src="{{guide.miniTrailSrc}}" mode="aspectFit"></image>
          </view>

          <text class="route-desc text-clamp-2" wx:if="{{guide.summary}}">{{guide.summary}}</text>

          <view class="route-tags" wx:if="{{guide.tags && guide.tags.length > 0}}">
            <view class="tag tag-route" wx:for="{{guide.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</view>
          </view>

          <view class="card-cta">
            <text class="cta-text">查看详情与地图</text>
            <image class="cta-arrow" src="/images/icons/chevron-right.svg" mode="aspectFit"></image>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
