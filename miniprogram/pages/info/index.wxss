/* pages/info/index.wxss · 实用信息仪表盘 · 沙金棕 */
.info-page {
  min-height: 100vh;
  background: var(--bg-canvas);
  padding-bottom: 80rpx;
}

/* === Hero · 复用 cat-info 主题 === */
.cat-hero {
  position: relative;
  overflow: hidden;
  padding: var(--space-2xl) var(--space-xl) var(--space-xl);
  background: var(--cat-info);
  color: var(--text-white);
}

.hero-meta { position: relative; z-index: 3; }

.hero-deco {
  position: absolute;
  top: -20rpx; right: -30rpx;
  width: 320rpx; height: 320rpx;
  pointer-events: none;
  animation: hero-deco-float 11s ease-in-out infinite;
}

@keyframes hero-deco-float {
  0%, 100% { transform: translate(0, 0) rotate(0deg); }
  33%      { transform: translate(-10rpx, 8rpx) rotate(-4deg); }
  66%      { transform: translate(8rpx, -8rpx) rotate(4deg); }
}

.hero-bubble {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.45);
  pointer-events: none;
}
.bubble-1 { bottom: -40rpx; left: 60rpx; width: 80rpx; height: 80rpx; background: rgba(255,255,255,0.06); animation: bubble-rise 12s ease-in-out infinite; }
.bubble-2 { bottom: -30rpx; left: 280rpx; width: 50rpx; height: 50rpx; background: rgba(255,255,255,0.08); animation: bubble-rise 14s ease-in-out infinite; animation-delay: -4s; }
.bubble-3 { bottom: -50rpx; right: 60rpx; width: 110rpx; height: 110rpx; background: rgba(255,255,255,0.04); animation: bubble-rise 16s ease-in-out infinite; animation-delay: -8s; }

@keyframes bubble-rise {
  0%   { transform: translateY(0) scale(1); opacity: 0.5; }
  50%  { transform: translateY(-30rpx) scale(1.05); opacity: 0.75; }
  100% { transform: translateY(0) scale(1); opacity: 0.5; }
}

.hero-glow {
  position: absolute; left: -10%; right: -10%; bottom: -10rpx; height: 80rpx;
  pointer-events: none;
  background:
    radial-gradient(ellipse 90rpx 35rpx at 25% 80%, rgba(255,255,255,0.28) 0%, transparent 70%),
    radial-gradient(ellipse 140rpx 40rpx at 60% 85%, rgba(255,255,255,0.22) 0%, transparent 70%),
    radial-gradient(ellipse 100rpx 35rpx at 90% 80%, rgba(255,255,255,0.26) 0%, transparent 70%);
}

.hero-eyebrow {
  font-size: var(--font-xs); letter-spacing: 4rpx;
  opacity: 0.85; font-weight: 500; margin-bottom: var(--space-xs);
}
.hero-title {
  font-size: 56rpx; font-weight: 700;
  letter-spacing: -1rpx; line-height: 1.15; margin-bottom: 6rpx;
}
.hero-sub {
  font-size: var(--font-sm); opacity: 0.82; letter-spacing: 0.5rpx;
}

/* === 离线 banner === */
.offline-banner {
  margin: -32rpx var(--space-lg) var(--space-md);
  padding: 14rpx 24rpx;
  background: #FFF6E5;
  border: 2rpx solid #F0C870;
  border-radius: var(--radius-md);
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-xs);
  color: #8B6914;
}
.offline-dot {
  color: #E89A3C; font-size: 16rpx;
  animation: dot-pulse 1.5s ease-in-out infinite;
}
@keyframes dot-pulse {
  0%, 100% { opacity: 0.4; }
  50%      { opacity: 1; }
}

/* === Section 通用 === */
.section {
  margin: var(--space-md) var(--space-lg);
  background: var(--bg-surface);
  border-radius: var(--radius-2xl);
  padding: var(--space-lg);
  box-shadow: var(--shadow-md);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
  gap: 12rpx;
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.3rpx;
}

.section-source {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  letter-spacing: 0.5rpx;
}

.module-error {
  padding: var(--space-xl) var(--space-md);
  text-align: center;
  color: var(--text-secondary);
  font-size: var(--font-sm);
}

.retry-btn {
  display: inline-block;
  margin-top: var(--space-md);
  padding: 12rpx 36rpx;
  background: var(--cat-info);
  color: var(--text-white);
  border-radius: var(--radius-pill);
  font-size: var(--font-xs);
  font-weight: 600;
  letter-spacing: 0.5rpx;
}
.retry-btn:active { transform: scale(0.96); opacity: 0.9; }

/* === 模块 A · 天气卡 === */
.weather-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.weather-main {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
}

.weather-emoji {
  font-size: 96rpx;
  line-height: 1;
}

.weather-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.weather-temp {
  font-size: 60rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -2rpx;
  line-height: 1.1;
}

.weather-summary {
  font-size: var(--font-sm);
  color: var(--text-secondary);
}

.weather-humidity {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
}

/* 活动评分 grid */
.score-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 12rpx;
  background: var(--bg-muted);
  border-radius: var(--radius-md);
}

.score-emoji {
  font-size: 32rpx;
  line-height: 1;
}

.score-label {
  font-size: var(--font-xs);
  color: var(--text-secondary);
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.stars-row {
  display: flex;
  gap: 4rpx;
  margin: 4rpx 0;
}

.star {
  width: 20rpx;
  height: 20rpx;
  border-radius: 2rpx;
  position: relative;
}

.star-full {
  background: #E89A3C;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

.star-half {
  background: linear-gradient(90deg, #E89A3C 0%, #E89A3C 50%, #D4CDBE 50%, #D4CDBE 100%);
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

.star-empty {
  background: #D4CDBE;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

.score-value {
  font-size: var(--font-xs);
  font-weight: 700;
  color: var(--cat-info);
  font-variant-numeric: tabular-nums;
}

/* === 模块 B · 潮汐 === */
.tide-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.tide-current {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, rgba(232, 154, 60, 0.08), rgba(30, 82, 102, 0.08));
  border-radius: var(--radius-md);
  border-left: 4rpx solid var(--cat-info);
}

.tide-current-label {
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
}

.tide-current-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--cat-info);
  letter-spacing: -0.5rpx;
  font-variant-numeric: tabular-nums;
}

.tide-current-trend {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 500;
  margin-left: auto;
}

.tide-canvas {
  width: 100%;
  height: 240rpx;
  background: rgba(30, 82, 102, 0.02);
  border-radius: var(--radius-md);
}

.tide-key-times {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
}

.key-time-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 14rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-muted);
}

.key-time-item.type-high {
  background: rgba(30, 82, 102, 0.08);
}

.key-time-item.type-low {
  background: rgba(62, 122, 110, 0.08);
}

.kt-icon {
  font-size: 24rpx;
  font-weight: 700;
}

.type-high .kt-icon { color: #1E5266; }
.type-low .kt-icon { color: #3E7A6E; }

.kt-info {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.kt-time {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.5rpx;
}

.kt-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.tide-source-note {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-align: center;
  letter-spacing: 0.5rpx;
}

/* === 模块 C · 渡轮 === */
.ferry-card {
  margin-top: var(--space-md);
}
.ferry-card:first-child { margin-top: 0; }

.ferry-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.ferry-route {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--text-primary);
}

.ferry-mode-tag {
  padding: 4rpx 14rpx;
  background: var(--cat-info-soft, rgba(232, 154, 60, 0.15));
  color: var(--cat-info);
  font-size: var(--font-xs);
  font-weight: 600;
  border-radius: var(--radius-pill);
  letter-spacing: 0.5rpx;
}

.ferry-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ferry-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  background: var(--bg-muted);
  border-radius: var(--radius-sm);
  position: relative;
}

.ferry-row.past {
  opacity: 0.4;
}

.ferry-row.next {
  background: rgba(232, 154, 60, 0.12);
  border-left: 4rpx solid var(--cat-info);
}

.ferry-time-col {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-variant-numeric: tabular-nums;
}

.ferry-departure {
  font-size: var(--font-sm);
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 0.5rpx;
}

.ferry-arrow {
  color: var(--text-tertiary);
  font-size: 22rpx;
}

.ferry-arrival {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  letter-spacing: 0.5rpx;
}

.next-badge {
  padding: 4rpx 12rpx;
  background: var(--cat-info);
  color: var(--text-white);
  font-size: 20rpx;
  font-weight: 700;
  border-radius: var(--radius-pill);
  letter-spacing: 1rpx;
}

.ferry-disclaimer {
  display: block;
  margin-top: var(--space-md);
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
  letter-spacing: 0.3rpx;
}

/* === 模块 D · 应急 POI === */
.loc-btn-mini {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  background: var(--cat-info);
  color: var(--text-white);
  font-size: var(--font-xs);
  border-radius: var(--radius-pill);
  font-weight: 600;
}

.loc-btn-mini:active { transform: scale(0.95); opacity: 0.9; }

.loc-icon-mini {
  width: 22rpx;
  height: 22rpx;
  filter: brightness(0) invert(1);
}

.emergency-tabs {
  display: flex;
  gap: 8rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
  margin-bottom: var(--space-md);
}

.emergency-tabs::-webkit-scrollbar { display: none; }

.em-tab {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  background: var(--bg-muted);
  color: var(--text-secondary);
  font-size: var(--font-xs);
  border-radius: var(--radius-pill);
  letter-spacing: 0.5rpx;
  font-weight: 500;
}

.em-tab.active {
  background: var(--cat-info);
  color: var(--text-white);
  font-weight: 600;
}

.emergency-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.em-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  background: var(--bg-muted);
  border-radius: var(--radius-md);
}

.em-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.em-name {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--text-primary);
}

.em-address {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.em-distance {
  font-size: 22rpx;
  color: var(--cat-info);
  font-variant-numeric: tabular-nums;
  margin-top: 2rpx;
}

.em-phone-btn {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  background: var(--cat-info);
  color: var(--text-white);
  font-size: var(--font-xs);
  font-weight: 600;
  border-radius: var(--radius-pill);
  letter-spacing: 0.3rpx;
  font-variant-numeric: tabular-nums;
}

.em-phone-btn:active { transform: scale(0.95); opacity: 0.9; }

.em-phone-btn.disabled {
  background: var(--bg-muted);
  color: var(--text-tertiary);
  pointer-events: none;
}

.phone-icon {
  width: 22rpx;
  height: 22rpx;
  filter: brightness(0) invert(1);
}

.empty-cat {
  padding: var(--space-xl);
  text-align: center;
  color: var(--text-tertiary);
  font-size: var(--font-xs);
}

/* === 页脚 === */
.page-footer {
  padding: var(--space-xl) var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  letter-spacing: 0.5rpx;
}
