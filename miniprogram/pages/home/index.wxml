<!--pages/home/index.wxml-->
<view class="home-container">
  <!-- Hero · 沉浸式头图 -->
  <view class="home-hero">
    <view class="hero-photo">
      <view class="hero-cloud cloud-1"></view>
      <view class="hero-cloud cloud-2"></view>
      <view class="hero-sun"></view>
      <view class="hero-wave"></view>
      <view class="hero-tint"></view>
    </view>
    <view class="hero-meta">
      <view class="hero-eyebrow-line">HUAHAI · 画海</view>
      <view class="hero-headline">在南澳,听海起风</view>
      <view class="hero-sub">精选攻略 · 海岛住宿 · 慢游南澳</view>
    </view>
  </view>

  <!-- 区块标题: 慢游主题 -->
  <view class="section-head">
    <view class="section-eyebrow">DISCOVER · 慢游主题</view>
    <view class="section-title">挑一个出发的理由</view>
  </view>

  <!-- 四类目 Bento 2×2 -->
  <view class="bento-grid home-bento">
    <view
      class="bento-item home-cat home-cat-{{item.id}} fade-in-up clickable"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="navigateToCategory"
      style="animation-delay: {{index * 60}}ms"
    >
      <image class="cat-icon" src="{{item.iconSrc}}" mode="aspectFit"></image>
      <view class="cat-spark"></view>
      <view class="cat-halo"></view>
      <view class="cat-meta">
        <view class="cat-name">{{item.name}}</view>
        <view class="cat-desc">{{item.desc}}</view>
      </view>
      <view class="cat-arrow">
        <image src="/images/icons/arrow-right-{{item.id}}.svg" mode="aspectFit"></image>
      </view>
    </view>
  </view>

  <!-- 民宿入口卡 -->
  <view class="home-hostel-card clickable" bindtap="navigateToHostel">
    <view class="hostel-card-bg"></view>
    <view class="hostel-card-content">
      <view class="hostel-card-eyebrow">STAY · 入住画海</view>
      <view class="hostel-card-title">海景房 · 落日窗</view>
      <view class="hostel-card-desc">慢下来,与潮汐同频</view>
      <view class="hostel-card-cta">
        <text>查看房型</text>
        <image class="hostel-card-arrow" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23FFFFFF' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M5 12 h 14'/%3E%3Cpath d='M13 5 l 7 7 -7 7'/%3E%3C/svg%3E" mode="aspectFit"></image>
      </view>
    </view>
  </view>

  <view class="home-footer-tag">
    <text>南澳岛 · 画海民宿出品</text>
  </view>
</view>
