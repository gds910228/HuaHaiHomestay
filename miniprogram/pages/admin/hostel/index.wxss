/* pages/admin/hostel/index.wxss */
.hostel-container {
  min-height: 100vh;
  background: var(--bg-canvas);
  padding-bottom: 120rpx;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: var(--bg-surface);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s;
}

.tab-item.active {
  color: var(--brand-primary);
  border-bottom-color: var(--brand-primary);
  font-weight: 500;
}

/* 标签内容 */
.tab-content {
  padding: 24rpx;
}

/* 民宿信息卡片 */
.info-card {
  padding: 32rpx;
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--divider-color);
}

.info-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.edit-btn {
  background: var(--brand-primary-soft);
  color: var(--brand-primary);
  border: none;
}

.info-section {
  margin-bottom: 24rpx;
}

.section-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}

.section-value {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.facilities-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.facility-tag {
  padding: 8rpx 20rpx;
  background: var(--brand-primary-soft);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--brand-primary);
}

.facility-empty {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 房型列表 */
.rooms-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.room-item {
  padding: 24rpx;
}

.room-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.room-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.room-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.room-category {
  background-color: var(--brand-primary-soft);
  color: var(--brand-primary);
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}

.room-price {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--brand-accent-strong);
  white-space: nowrap;
}

.room-info {
  display: flex;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

.info-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.room-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.tag {
  padding: 6rpx 16rpx;
  background: var(--brand-primary-soft);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--brand-primary);
}

.room-actions {
  display: flex;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider-color);
}

.action-btn {
  flex: 1;
}

.action-btn.edit {
  background: var(--brand-primary-soft);
  color: var(--brand-primary);
}

.action-btn.delete {
  background: var(--color-danger-soft);
  color: var(--color-danger);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-bottom: 32rpx;
}

.empty-btn {
  width: 240rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

/* 添加按钮 */
.add-btn {
  position: fixed;
  right: 32rpx;
  bottom: 100rpx;
  width: 112rpx;
  height: 112rpx;
  background: var(--brand-primary);
  border-radius: 56rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 82, 102, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.add-icon {
  font-size: 64rpx;
  color: var(--bg-surface);
  font-weight: 300;
}
