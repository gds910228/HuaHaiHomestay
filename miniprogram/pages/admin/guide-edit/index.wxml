<!--pages/admin/guide-edit/index.wxml-->
<view class="edit-container">
  <view class="form-section">
    <!-- 基本信息 -->
    <view class="form-item">
      <text class="form-label">标题 *</text>
      <input
        class="form-input"
        placeholder="请输入攻略标题"
        value="{{form.title}}"
        data-field="title"
        bindinput="onInput"
        maxlength="50"
      />
    </view>

    <view class="form-item">
      <text class="form-label">分类 *</text>
      <picker
        class="form-picker"
        range="{{categories}}"
        range-key="label"
        value="{{form.category}}"
        bindchange="onCategoryChange"
      >
        <view class="picker-value">{{categoryLabel}}</view>
      </picker>
    </view>

    <!-- 美食分类专属：所属区域 -->
    <view class="form-item" wx:if="{{form.category === 'food'}}">
      <text class="form-label">所属区域</text>
      <picker
        class="form-picker"
        range="{{areaOptions}}"
        value="{{areaIndex}}"
        bindchange="onAreaChange"
      >
        <view class="picker-value">{{form.area || '请选择区域（影响首页 Tab 分组）'}}</view>
      </picker>
    </view>

    <!-- 标签管理 -->
    <view class="form-item">
      <text class="form-label">标签</text>

      <!-- 已选标签 chips -->
      <view class="tag-chip-list" wx:if="{{form.tags.length > 0}}">
        <view class="tag-chip selected" wx:for="{{form.tags}}" wx:key="*this" wx:for-item="tag">
          <text class="tag-chip-text">{{tag}}</text>
          <text class="tag-chip-close" catchtap="removeTag" data-index="{{index}}">×</text>
        </view>
      </view>

      <!-- 添加标签输入区 -->
      <view class="tag-input-row">
        <input
          class="form-input tag-input"
          placeholder="输入标签后回车，如：必打卡"
          value="{{tagInput}}"
          bindinput="onTagInput"
          bindconfirm="addTag"
          confirm-type="done"
        />
        <view class="tag-add-btn" bindtap="addTag">添加</view>
      </view>

      <!-- 推荐标签云 -->
      <block wx:if="{{suggestedTags.length > 0}}">
        <text class="tag-cloud-label">常用标签（点击快速添加）</text>
        <view class="tag-cloud">
          <view
            class="tag-chip cloud {{form.tags.indexOf(item.name) > -1 ? 'selected' : ''}}"
            wx:for="{{suggestedTags}}"
            wx:key="name"
            data-tag="{{item.name}}"
            bindtap="toggleSuggestedTag"
          >
            <text class="tag-chip-text">{{item.name}}</text>
            <text class="tag-chip-count" wx:if="{{item.count}}">·{{item.count}}</text>
          </view>
        </view>
      </block>
    </view>

    <view class="form-item">
      <text class="form-label">摘要 *</text>
      <textarea
        class="form-textarea"
        placeholder="请输入简要描述"
        value="{{form.summary}}"
        data-field="summary"
        bindinput="onInput"
        maxlength="200"
      />
    </view>

    <!-- 封面图 -->
    <view class="form-item">
      <text class="form-label">封面图片（用于列表卡片缩略图）</text>
      <view class="image-upload">
        <view class="uploaded-images" wx:if="{{form.cover}}">
          <view class="image-item">
            <image
              class="upload-image"
              src="{{form.cover}}"
              mode="aspectFill"
              data-url="{{form.cover}}"
              data-type="cover"
              bindtap="previewImage"
            />
            <view class="delete-btn" catchtap="deleteCover">✕</view>
          </view>
        </view>
        <view class="upload-btn" wx:if="{{!form.cover}}" bindtap="chooseCover">
          <text class="upload-icon">+</text>
          <text class="upload-text">上传封面</text>
        </view>
      </view>
    </view>

    <!-- 图片列表 -->
    <view class="form-item">
      <text class="form-label">图片列表（最多9张 · 用 ← → 调整顺序）</text>
      <view class="image-upload">
        <view class="uploaded-images">
          <view class="image-item" wx:for="{{form.images}}" wx:key="*this">
            <image
              class="upload-image"
              src="{{item}}"
              mode="aspectFill"
              data-url="{{item}}"
              data-type="images"
              data-index="{{index}}"
              bindtap="previewImage"
            />
            <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">✕</view>
            <view class="reorder-bar">
              <view
                class="reorder-btn {{index === 0 ? 'disabled' : ''}}"
                catchtap="moveImageLeft"
                data-index="{{index}}"
              >‹</view>
              <text class="reorder-pos">{{index + 1}}</text>
              <view
                class="reorder-btn {{index === form.images.length - 1 ? 'disabled' : ''}}"
                catchtap="moveImageRight"
                data-index="{{index}}"
              >›</view>
            </view>
          </view>
        </view>
        <view class="upload-btn" wx:if="{{form.images.length < 9}}" bindtap="chooseImages">
          <text class="upload-icon">+</text>
          <text class="upload-text">添加图片</text>
        </view>
      </view>
    </view>

    <!-- 富文本正文 -->
    <view class="form-item">
      <text class="form-label">详细内容 *</text>

      <!-- 工具栏 -->
      <view class="editor-toolbar">
        <view class="tb-btn {{formats.header == 2 ? 'active' : ''}}" data-name="header" data-value="2" bindtap="formatTap">H</view>
        <view class="tb-btn {{formats.bold ? 'active' : ''}}" data-name="bold" bindtap="formatTap">
          <text class="tb-bold">B</text>
        </view>
        <view class="tb-btn {{formats.italic ? 'active' : ''}}" data-name="italic" bindtap="formatTap">
          <text class="tb-italic">I</text>
        </view>
        <view class="tb-btn {{formats.underline ? 'active' : ''}}" data-name="underline" bindtap="formatTap">
          <text class="tb-underline">U</text>
        </view>
        <view class="tb-btn" data-name="list" data-value="ordered" bindtap="formatTap">1.</view>
        <view class="tb-btn" data-name="list" data-value="bullet" bindtap="formatTap">•</view>
        <view class="tb-btn" data-name="align" data-value="left" bindtap="formatTap">⇤</view>
        <view class="tb-btn" data-name="align" data-value="center" bindtap="formatTap">≡</view>
        <view class="tb-btn primary" bindtap="insertImage">🖼 图</view>
        <view class="tb-btn" bindtap="editorUndo">↺</view>
        <view class="tb-btn" bindtap="editorRedo">↻</view>
        <view class="tb-btn danger" bindtap="editorClear">清</view>
      </view>

      <!-- 富文本编辑器 -->
      <editor
        id="editor"
        class="rich-editor"
        placeholder="在此输入正文，支持加粗、斜体、列表、插入图片..."
        show-img-size="{{true}}"
        show-img-toolbar="{{true}}"
        show-img-resize="{{true}}"
        bindready="onEditorReady"
        bindstatuschange="onStatusChange"
        bindinput="onContentInput"
        bindfocus="onEditorFocus"
        bindblur="onEditorBlur"
      ></editor>
    </view>

    <view class="form-item">
      <text class="form-label">地址</text>
      <input
        class="form-input"
        placeholder="请输入详细地址"
        value="{{form.address}}"
        data-field="address"
        bindinput="onInput"
      />
    </view>

    <!-- ============ 路线规划专属面板(category=route) ============ -->
    <block wx:if="{{form.category === 'route'}}">
      <view class="route-panel">
        <view class="route-panel-head" bindtap="toggleRoutePanel">
          <text class="rp-title">路线规划</text>
          <text class="rp-hint" wx:if="{{form.waypoints.length > 0}}">{{form.waypoints.length}} 个点位</text>
          <text class="rp-toggle">{{routePanelExpanded ? '▾' : '▸'}}</text>
        </view>

        <view class="route-panel-body" wx:if="{{routePanelExpanded}}">
          <!-- days / transport -->
          <view class="rp-row">
            <view class="rp-col">
              <text class="rp-label">天数</text>
              <picker
                class="rp-picker"
                range="{{daysOptions}}"
                value="{{daysIndex}}"
                bindchange="onDaysChange"
              >
                <view class="rp-picker-value">{{form.days}} 日游</view>
              </picker>
            </view>
            <view class="rp-col">
              <text class="rp-label">交通方式</text>
              <picker
                class="rp-picker"
                range="{{transportOptions}}"
                range-key="label"
                value="{{transportIndex}}"
                bindchange="onTransportChange"
              >
                <view class="rp-picker-value">{{transportOptions[transportIndex].label}}</view>
              </picker>
            </view>
          </view>

          <!-- mixed 模式:每天的交通方式 -->
          <view class="rp-day-transport" wx:if="{{form.transport === 'mixed'}}">
            <text class="rp-sub-label">各日交通方式</text>
            <view class="rp-dt-list">
              <view
                class="rp-dt-item"
                wx:for="{{dayArray}}"
                wx:key="*this"
                wx:for-item="dayNum"
                wx:for-index="dIdx"
                data-day="{{dayNum}}"
                bindtap="onDayTransportToggle"
              >
                <text class="rp-dt-day">D{{dayNum}}</text>
                <text class="rp-dt-mode">{{dayTransportLabels[dIdx]}}</text>
              </view>
            </view>
            <text class="rp-hint-text">点击切换驾车/步行</text>
          </view>

          <!-- waypoints 列表 -->
          <text class="rp-section-title">点位列表 ({{form.waypoints.length}})</text>
          <view class="wp-edit-list">
            <view class="wp-edit-card" wx:for="{{form.waypoints}}" wx:key="index" wx:for-item="wp" wx:for-index="wpIdx">
              <view class="wp-edit-head">
                <text class="wp-edit-no">#{{wpIdx + 1}}</text>
                <view class="wp-edit-actions">
                  <view
                    class="wpa-btn {{wpIdx === 0 ? 'disabled' : ''}}"
                    catchtap="moveWaypointUp"
                    data-index="{{wpIdx}}"
                  >↑</view>
                  <view
                    class="wpa-btn {{wpIdx === form.waypoints.length - 1 ? 'disabled' : ''}}"
                    catchtap="moveWaypointDown"
                    data-index="{{wpIdx}}"
                  >↓</view>
                  <view
                    class="wpa-btn danger"
                    catchtap="removeWaypoint"
                    data-index="{{wpIdx}}"
                  >×</view>
                </view>
              </view>

              <input
                class="wp-input"
                placeholder="点位名称(如:长山尾灯塔)"
                value="{{wp.name}}"
                data-index="{{wpIdx}}"
                data-field="name"
                bindinput="onWaypointInput"
              />

              <!-- 选地图按钮独占一行,醒目 -->
              <view
                class="wp-choose-loc-btn"
                data-index="{{wpIdx}}"
                bindtap="chooseWaypointLocation"
              >
                <image class="wp-choose-icon" src="/images/icons/pin.svg" mode="aspectFit"></image>
                <text>从地图选取位置</text>
              </view>

              <!-- 经纬度同行,各 50% -->
              <view class="wp-coord-row">
                <view class="wp-coord-col">
                  <text class="wp-mini-label">纬度</text>
                  <input
                    class="wp-input wp-coord-input"
                    placeholder="23.4566"
                    value="{{wp.latitude}}"
                    data-index="{{wpIdx}}"
                    data-field="latitude"
                    bindinput="onWaypointInput"
                    type="digit"
                  />
                </view>
                <view class="wp-coord-col">
                  <text class="wp-mini-label">经度</text>
                  <input
                    class="wp-input wp-coord-input"
                    placeholder="117.1310"
                    value="{{wp.longitude}}"
                    data-index="{{wpIdx}}"
                    data-field="longitude"
                    bindinput="onWaypointInput"
                    type="digit"
                  />
                </view>
              </view>

              <!-- 第几天 + 停留分钟同行,各 50% -->
              <view class="wp-coord-row">
                <view class="wp-coord-col">
                  <text class="wp-mini-label">第几天</text>
                  <picker
                    class="wp-day-picker"
                    range="{{daysOptions}}"
                    value="{{wp.dayIndex - 1}}"
                    data-index="{{wpIdx}}"
                    bindchange="onWaypointDayChange"
                  >
                    <view class="wp-day-val">D{{wp.dayIndex}}</view>
                  </picker>
                </view>
                <view class="wp-coord-col">
                  <text class="wp-mini-label">停留 (分钟)</text>
                  <input
                    class="wp-input wp-coord-input"
                    placeholder="30"
                    value="{{wp.stayMin}}"
                    data-index="{{wpIdx}}"
                    data-field="stayMin"
                    bindinput="onWaypointInput"
                    type="number"
                  />
                </view>
              </view>

              <textarea
                class="wp-textarea"
                placeholder="点位介绍(可选)"
                value="{{wp.desc}}"
                data-index="{{wpIdx}}"
                data-field="desc"
                bindinput="onWaypointInput"
                maxlength="200"
                auto-height="{{true}}"
              />

              <input
                class="wp-input wp-tip-input"
                placeholder="特别提示(可选,如:⭐ 日落首选,17:00前到)"
                value="{{wp.tip}}"
                data-index="{{wpIdx}}"
                data-field="tip"
                bindinput="onWaypointInput"
              />
            </view>
          </view>

          <view class="wp-add-btn" bindtap="addWaypoint">+ 添加点位</view>

          <text class="rp-tip" wx:if="{{form.waypoints.length >= 2}}">保存后将自动重新规划路线</text>
        </view>
      </view>
    </block>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions">
    <button class="action-btn primary" bindtap="save" disabled="{{uploading}}">
      <text>{{isEdit ? '更新' : '发布'}}攻略</text>
    </button>
  </view>
</view>
