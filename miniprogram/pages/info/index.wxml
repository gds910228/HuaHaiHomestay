<!--pages/info/index.wxml · 实用信息仪表盘-->
<view class="info-page">
  <!-- Hero · 沿用 cat-info 暖橙主题装饰 -->
  <view class="cat-hero">
    <image class="hero-deco" src="/images/icons/deco-info-white.svg" mode="aspectFit"></image>
    <view class="hero-bubble bubble-1"></view>
    <view class="hero-bubble bubble-2"></view>
    <view class="hero-bubble bubble-3"></view>
    <view class="hero-glow"></view>
    <view class="hero-meta">
      <view class="hero-eyebrow">DASHBOARD · 实用信息</view>
      <view class="hero-title">出行就看这里</view>
      <view class="hero-sub">天气 · 潮汐 · 渡轮 · 应急</view>
    </view>
  </view>

  <!-- 离线提示条 -->
  <view class="offline-banner" wx:if="{{isOffline}}">
    <text class="offline-dot">●</text>
    <text>当前为离线数据,下拉刷新重试</text>
  </view>

  <!-- ============ 模块 A · 天气 + 活动评分 ============ -->
  <view class="section weather-section">
    <view class="section-head">
      <text class="section-title">今日天气 · 活动指数</text>
      <text class="section-source" wx:if="{{weatherDisplay.sourceSpot}}">{{weatherDisplay.sourceSpot}}</text>
    </view>

    <block wx:if="{{weatherLoading && !weather}}">
      <skeleton-card></skeleton-card>
    </block>

    <block wx:elif="{{weatherError && !weather}}">
      <view class="module-error">
        <text>{{weatherError}}</text>
        <view class="retry-btn" data-module="weather" bindtap="retryModule">重试</view>
      </view>
    </block>

    <view class="weather-card" wx:elif="{{weatherDisplay}}">
      <view class="weather-main">
        <text class="weather-emoji">{{weatherDisplay.emoji}}</text>
        <view class="weather-info">
          <text class="weather-temp">{{weatherDisplay.tempStr}}</text>
          <text class="weather-summary">{{weatherDisplay.summary}}</text>
          <text class="weather-humidity" wx:if="{{weatherDisplay.humidityStr}}">湿度 {{weatherDisplay.humidityStr}}</text>
        </view>
      </view>

      <!-- 活动评分 grid -->
      <view class="score-grid">
        <view class="score-item" wx:for="{{scoreItems}}" wx:key="key">
          <text class="score-emoji">{{item.emoji}}</text>
          <text class="score-label">{{item.label}}</text>
          <view class="stars-row">
            <view
              wx:for="{{item.stars}}"
              wx:key="*this"
              wx:for-item="star"
              wx:for-index="sIdx"
              class="star star-{{star}}"
            ></view>
          </view>
          <text class="score-value">{{item.valueDisplay}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ============ 模块 B · 潮汐曲线 ============ -->
  <view class="section tide-section">
    <view class="section-head">
      <text class="section-title">潮汐 · {{tide.date || '今日'}}</text>
      <text class="section-source" wx:if="{{tide.station}}">{{tide.station}}</text>
    </view>

    <block wx:if="{{tideLoading && !tide}}">
      <skeleton-card></skeleton-card>
    </block>

    <block wx:elif="{{tideError && !tide}}">
      <view class="module-error">
        <text>{{tideError}}</text>
        <view class="retry-btn" data-module="tide" bindtap="retryModule">重试</view>
      </view>
    </block>

    <view class="tide-card" wx:elif="{{tide}}">
      <view class="tide-current" wx:if="{{tide.currentHeight != null}}">
        <text class="tide-current-label">现在</text>
        <text class="tide-current-value">{{tide.currentHeight}}m</text>
        <text class="tide-current-trend">
          {{tide.currentTrend === 'rising' ? '↑ 涨潮' : (tide.currentTrend === 'falling' ? '↓ 退潮' : '— 平潮')}}
        </text>
      </view>

      <canvas
        type="2d"
        id="tide-canvas"
        class="tide-canvas"
      ></canvas>

      <view class="tide-key-times">
        <view class="key-time-item type-{{item.type}}" wx:for="{{tideKeyTimes}}" wx:key="time">
          <text class="kt-icon">{{item.typeIcon}}</text>
          <view class="kt-info">
            <text class="kt-time">{{item.time}}</text>
            <text class="kt-label">{{item.typeLabel}} {{item.height}}m</text>
          </view>
        </view>
      </view>

      <text class="tide-source-note">
        {{tide.source === 'manual' ? '数据来源:手工录入 · ' + (tide.station || '官方潮汐表') :
          (tide.source === 'chaoxibiao' ? '数据来源:大鱼潮汐表 · ' + (tide.lunar || '') + (tide.tideType ? ' · ' + tide.tideType : '') :
            (tide.source === 'harmonic' ? '本地谐波算法(±30-60min)· 仅供参考' :
              (tide.source === 'seed' ? '⚠ 可能存在偏差 · 请以官方为准' :
                '数据来源:WorldTides · 仅供参考')))}}
      </text>
    </view>
  </view>

  <!-- ============ 模块 C · 渡轮班次 ============ -->
  <view class="section ferries-section">
    <view class="section-head">
      <text class="section-title">渡轮 · 莱长渡口</text>
      <text class="section-source" wx:if="{{ferries[0].isHoliday}}">节假日加密班次</text>
    </view>

    <block wx:if="{{ferriesLoading && !ferries}}">
      <skeleton-card></skeleton-card>
    </block>

    <block wx:elif="{{ferriesError && (!ferries || ferries.length === 0)}}">
      <view class="module-error">
        <text>{{ferriesError}}</text>
        <view class="retry-btn" data-module="ferries" bindtap="retryModule">重试</view>
      </view>
    </block>

    <view class="ferry-card" wx:for="{{ferries}}" wx:key="_id" wx:for-item="ferry">
      <view class="ferry-route-head">
        <text class="ferry-route">{{ferry.route}}</text>
      </view>

      <!-- 子 tab:班次 / 收费 / 联系 -->
      <view class="ferry-tabs">
        <view class="ferry-tab {{ferryTab === 'schedule' ? 'active' : ''}}" data-tab="schedule" bindtap="selectFerryTab">班次</view>
        <view class="ferry-tab {{ferryTab === 'price' ? 'active' : ''}}" data-tab="price" bindtap="selectFerryTab">收费</view>
        <view class="ferry-tab {{ferryTab === 'contact' ? 'active' : ''}}" data-tab="contact" bindtap="selectFerryTab">联系 / 提醒</view>
      </view>

      <!-- Tab 1: 班次 -->
      <view class="ferry-tab-pane" wx:if="{{ferryTab === 'schedule'}}">
        <!-- 进岛 -->
        <view class="ferry-direction-block">
          <view class="ferry-direction-head">
            <text class="ferry-dir-icon">→</text>
            <text class="ferry-dir-name">进岛(莱芜 → 长山尾)</text>
          </view>
          <view class="ferry-trip-list">
            <view
              class="ferry-trip {{t.isPast ? 'past' : ''}} {{idx === ferry.toIslandNextIdx ? 'next' : ''}}"
              wx:for="{{ferry.toIsland}}"
              wx:key="departure"
              wx:for-item="t"
              wx:for-index="idx"
            >
              <text class="ferry-time">{{t.departure}}</text>
              <text class="ferry-sell-info" wx:if="{{t.sellStart}}">售 {{t.sellStart}}~{{t.departure}}</text>
              <view class="holiday-badge" wx:if="{{t.isHolidayExtra}}">假日加班</view>
            </view>
          </view>
        </view>

        <!-- 出岛 -->
        <view class="ferry-direction-block">
          <view class="ferry-direction-head">
            <text class="ferry-dir-icon ferry-dir-back">←</text>
            <text class="ferry-dir-name">出岛(长山尾 → 莱芜)</text>
          </view>
          <view class="ferry-trip-list">
            <view
              class="ferry-trip {{t.isPast ? 'past' : ''}} {{idx === ferry.toMainlandNextIdx ? 'next' : ''}}"
              wx:for="{{ferry.toMainland}}"
              wx:key="departure"
              wx:for-item="t"
              wx:for-index="idx"
            >
              <text class="ferry-time">{{t.departure}}</text>
              <view class="holiday-badge" wx:if="{{t.isHolidayExtra}}">假日加班</view>
            </view>
          </view>
        </view>

        <text class="ferry-note" wx:if="{{ferry.ticketingNote}}">{{ferry.ticketingNote}}</text>
      </view>

      <!-- Tab 2: 收费 -->
      <view class="ferry-tab-pane" wx:if="{{ferryTab === 'price'}}">
        <view class="price-table">
          <view
            class="price-row {{p.highlight ? 'highlight' : ''}}"
            wx:for="{{ferry.prices}}"
            wx:key="item"
            wx:for-item="p"
          >
            <text class="price-item">{{p.item}}</text>
            <view class="price-amount-col">
              <text class="price-amount">¥{{p.amount}}</text>
              <text class="price-unit">{{p.unit}}{{p.suffix || ''}}</text>
            </view>
          </view>
        </view>
        <view class="price-notes">
          <view class="price-note-row" wx:for="{{ferry.priceNotes}}" wx:key="*this">
            <text class="note-dot">·</text>
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <!-- Tab 3: 联系 + 出行提醒 -->
      <view class="ferry-tab-pane" wx:if="{{ferryTab === 'contact'}}">
        <view class="contact-list">
          <view
            class="contact-row"
            wx:for="{{ferry.contacts}}"
            wx:key="phone"
            data-phone="{{item.phone}}"
            bindtap="callPhone"
            bindlongpress="copyPhone"
          >
            <view class="contact-info">
              <text class="contact-name">{{item.name}}</text>
              <text class="contact-phone">{{item.phone}}</text>
            </view>
            <image class="contact-icon" src="/images/icons/phone.svg" mode="aspectFit"></image>
          </view>
        </view>

        <view class="official-account" wx:if="{{ferry.officialAccount}}">
          <text class="oa-label">📌 关注公众号获取最新通知:</text>
          <text class="oa-name">「{{ferry.officialAccount}}」</text>
        </view>

        <view class="tip-list">
          <view class="tip-row" wx:for="{{ferry.tips}}" wx:key="title">
            <text class="tip-title">{{item.title}}</text>
            <text class="tip-content">{{item.content}}</text>
          </view>
        </view>
      </view>

      <text class="ferry-disclaimer">{{ferry.disclaimer}}</text>
    </view>
  </view>

  <!-- ============ 模块 D · 应急联系 ============ -->
  <view class="section emergency-section">
    <view class="section-head">
      <text class="section-title">应急 & 便民</text>
      <view class="loc-btn-mini" wx:if="{{!hasUserLocation}}" bindtap="useMyLocation">
        <image class="loc-icon-mini" src="/images/icons/pin.svg" mode="aspectFit"></image>
        <text>按距离排序</text>
      </view>
      <text class="section-source" wx:elif="{{hasUserLocation}}">📍 已按距离排序</text>
    </view>

    <block wx:if="{{emergencyLoading && !emergency}}">
      <skeleton-card></skeleton-card>
    </block>

    <block wx:elif="{{emergencyError && !emergency}}">
      <view class="module-error">
        <text>{{emergencyError}}</text>
        <view class="retry-btn" data-module="emergency" bindtap="retryModule">重试</view>
      </view>
    </block>

    <block wx:elif="{{emergency}}">
      <!-- 分类 tab(水平滚动) -->
      <scroll-view class="emergency-tabs" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view
          class="em-tab {{activeEmergencyCat === cat ? 'active' : ''}}"
          wx:for="{{emergencyCategoryOrder}}"
          wx:key="*this"
          wx:for-item="cat"
          data-cat="{{cat}}"
          bindtap="selectEmergencyCat"
        >
          <text>{{emergencyCategoryLabels[cat]}}</text>
          <text class="em-tab-count" wx:if="{{emergency.grouped[cat] && emergency.grouped[cat].length > 0}}">{{emergency.grouped[cat].length}}</text>
        </view>
      </scroll-view>

      <!-- 当前分类列表 -->
      <view class="emergency-list">
        <view
          class="em-row"
          wx:for="{{emergency.grouped[activeEmergencyCat]}}"
          wx:key="_id"
          wx:for-item="poi"
        >
          <view class="em-info">
            <text class="em-name">{{poi.name}}</text>
            <text class="em-subtitle text-ellipsis" wx:if="{{poi.subtitle}}">{{poi.subtitle}}</text>
            <text class="em-address text-ellipsis" wx:if="{{poi.address && poi.address !== '全国统一' && poi.address !== '南澳县旅游服务' && poi.address !== '南澳县政府'}}">{{poi.address}}</text>
            <text class="em-distance" wx:if="{{poi.distanceDisplay}}">📍 {{poi.distanceDisplay}}</text>
          </view>

          <!-- 多号码:横排,每个独立可点 -->
          <view class="em-phone-list" wx:if="{{poi.phoneList && poi.phoneList.length > 0}}">
            <view
              class="em-phone-btn"
              wx:for="{{poi.phoneList}}"
              wx:key="raw"
              wx:for-item="ph"
              data-phone="{{ph.raw}}"
              catchtap="callPhone"
              catchlongpress="copyPhone"
            >
              <image class="phone-icon" src="/images/icons/phone.svg" mode="aspectFit"></image>
              <text>{{ph.raw}}</text>
            </view>
          </view>
        </view>

        <view class="empty-cat" wx:if="{{!emergency.grouped[activeEmergencyCat] || emergency.grouped[activeEmergencyCat].length === 0}}">
          <text>该分类暂无数据</text>
        </view>
      </view>
    </block>
  </view>

  <view class="page-footer">
    <text>数据来源:QWeather · WorldTides · 公开整理</text>
    <text wx:if="{{cachedAtDisplay}}">缓存于 {{cachedAtDisplay}}</text>
  </view>
</view>
