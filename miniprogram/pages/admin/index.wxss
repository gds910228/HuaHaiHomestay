/* pages/admin/index.wxss */
.admin-container {
  min-height: 100vh;
  background: var(--bg-canvas);
}

.app-logo-image {
  display: block;
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto var(--space-md);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-md);
}

/* === 登录区 === */
.login-section {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: var(--space-lg);
}

.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 600rpx;
  padding: var(--space-2xl) var(--space-xl) var(--space-xl);
  background: var(--bg-surface);
  border-radius: var(--radius-2xl);
  box-shadow: var(--shadow-md);
}

.login-eyebrow {
  font-size: var(--font-xs);
  letter-spacing: 6rpx;
  color: var(--text-tertiary);
  font-weight: 500;
  margin-bottom: 4rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
  margin-bottom: 8rpx;
}

.login-desc {
  font-size: var(--font-sm);
  color: var(--text-tertiary);
  margin-bottom: var(--space-2xl);
}

.login-btn {
  width: 100%;
  height: 96rpx;
}

/* === 已登录 === */
.admin-content {
  padding: var(--space-lg);
  padding-bottom: var(--space-2xl);
}

.welcome-card {
  position: relative;
  padding: var(--space-2xl) var(--space-xl);
  margin-bottom: var(--space-lg);
  background: var(--brand-primary);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  color: var(--text-white);
}

.welcome-card::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232, 145, 109, 0.4) 0%, transparent 70%);
}

.welcome-eyebrow {
  font-size: var(--font-xs);
  letter-spacing: 4rpx;
  opacity: 0.85;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.welcome-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  margin-bottom: 6rpx;
}

.welcome-desc {
  display: block;
  font-size: var(--font-sm);
  opacity: 0.82;
}

/* === 菜单 === */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.menu-card {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-lg);
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  transition: all var(--duration-fast) var(--ease-out);
}

.menu-card:active {
  transform: scale(0.99);
  box-shadow: var(--shadow-md);
}

.menu-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-icon-brand { background: var(--brand-primary-soft); }
.menu-icon-accent { background: var(--brand-accent-soft); }

.menu-icon { width: 44rpx; height: 44rpx; }

.menu-info {
  flex: 1;
  min-width: 0;
}

.menu-title {
  display: block;
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
  letter-spacing: -0.3rpx;
}

.menu-desc {
  display: block;
  font-size: var(--font-xs);
  color: var(--text-tertiary);
  letter-spacing: 0.5rpx;
}

.menu-arrow {
  width: 28rpx;
  height: 28rpx;
}

/* 退出 */
.logout-section {
  margin-top: var(--space-2xl);
}

.logout-btn {
  width: 100%;
  height: 96rpx;
}
