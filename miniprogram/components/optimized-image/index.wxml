<!--components/optimized-image/index.wxml-->
<view class="optimized-image-container {{mode}}" style="width: {{width}}; height: {{height}};">
  <!-- 实际图片 -->
  <image
    class="optimized-image {{loaded ? 'loaded' : 'loading'}} {{errored ? 'error' : ''}}"
    src="{{src}}"
    mode="{{imageMode}}"
    lazy-load="{{lazyLoad}}"
    show-menu-by-longpress="{{showMenuByLongpress}}"
    bindload="handleLoad"
    binderror="handleError"
    wx:if="{{!errored}}"
  ></image>

  <!-- 加载占位 -->
  <view class="image-placeholder" wx:if="{{!loaded && !errored}}">
    <view class="placeholder-loading">
      <view class="loading-spinner"></view>
    </view>
  </view>

  <!-- 错误占位 -->
  <view class="image-error" wx:if="{{errored}}">
    <image class="error-icon" src="data:image/svg+xml;utf8,%3Csvg xmlns='http%3A//www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23A39A8D' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'%3E%3Crect x='3' y='4' width='18' height='16' rx='2'/%3E%3Ccircle cx='9' cy='10' r='1.6'/%3E%3Cpath d='M3 17 l 5 -5 4 4 4 -3 5 6'/%3E%3C/svg%3E" mode="aspectFit"></image>
    <text class="error-text">图片加载失败</text>
  </view>

  <!-- 提示徽章 -->
  <view class="image-badge" wx:if="{{badge && loaded}}">
    <text class="badge-text">{{badge}}</text>
  </view>
</view>
