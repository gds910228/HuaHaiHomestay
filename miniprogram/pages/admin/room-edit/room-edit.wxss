/* pages/admin/room-edit/room-edit.wxss */
.room-edit-page {
  min-height: 100vh;
  background-color: var(--bg-muted);
  padding-bottom: 160rpx;
}

/* 通用section */
.form-section {
  background-color: var(--bg-surface);
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}

.image-count {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: normal;
  margin-left: 8rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.form-label.required::before {
  content: '*';
  color: var(--color-danger);
  margin-right: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: var(--bg-canvas);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  line-height: 88rpx;
}

.form-picker {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: var(--bg-canvas);
  border-radius: 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.picker-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 20rpx 24rpx;
  background-color: var(--bg-canvas);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  line-height: 1.6;
}

/* 开关项 */
.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-left: 16rpx;
}

/* 标签 */
.tag-input-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.tag-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background-color: var(--bg-canvas);
  border-radius: 12rpx;
  font-size: 28rpx;
}

.tag-add-btn {
  width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  background-color: var(--brand-primary);
  color: var(--bg-surface);
  font-size: 28rpx;
  border-radius: 12rpx;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background-color: var(--brand-primary-soft);
  border-radius: 24rpx;
}

.tag-text {
  font-size: 26rpx;
  color: var(--brand-primary);
  margin-right: 8rpx;
}

.tag-delete {
  font-size: 32rpx;
  color: var(--brand-primary);
  font-weight: bold;
  line-height: 1;
}

/* 图片网格 */
.manual-add-image {
  margin-bottom: 24rpx;
  padding: 20rpx;
  background-color: var(--color-warning-soft);
  border-radius: 12rpx;
}

.input-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.url-input {
  flex: 1;
  padding: 16rpx 20rpx;
  background-color: var(--bg-surface);
  border: 1rpx solid var(--border-line);
  border-radius: 8rpx;
  font-size: 26rpx;
}

.url-add-btn {
  width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  background-color: var(--brand-primary);
  color: var(--bg-surface);
  font-size: 26rpx;
  border-radius: 8rpx;
}

.tip-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
}

.divider {
  height: 1rpx;
  background-color: var(--divider-color);
  margin: 20rpx 0;
}

.images-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-thumb {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  color: var(--bg-surface);
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.image-upload {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background-color: var(--bg-canvas);
  border: 2rpx dashed var(--border-line);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -60%);
  font-size: 64rpx;
  color: var(--text-tertiary);
  line-height: 1;
}

.upload-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, 40%);
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 设施分类 */
.facility-group {
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid var(--divider-color);
  padding-bottom: 20rpx;
}

.facility-group:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.facility-group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  margin-bottom: 12rpx;
}

.group-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.toggle-icon {
  width: 28rpx;
  height: 28rpx;
  transition: transform 200ms var(--ease-out);
}

.toggle-icon.open {
  transform: rotate(180deg);
}

.facility-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-left: 20rpx;
}

.facility-option {
  padding: 12rpx 20rpx;
  background-color: var(--bg-muted);
  border: 2rpx solid var(--border-line);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  transition: all 0.3s;
  position: relative;
}

.facility-option.active {
  background-color: var(--color-success-soft);
  border-color: var(--color-success);
  color: var(--color-success);
  font-weight: 500;
}

.facility-option.active::after {
  content: '✓';
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  background-color: var(--color-success);
  color: var(--bg-surface);
  border-radius: 50%;
  font-size: 18rpx;
  line-height: 32rpx;
  text-align: center;
}

/* 接待要求 */
.requirement-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.requirement-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--divider-color);
}

.requirement-item:last-child {
  border-bottom: none;
}

.requirement-label {
  flex: 1;
}

.label-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 底部保存栏 */
.bottom-save-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: var(--bg-surface);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: var(--brand-primary);
  color: var(--bg-surface);
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn[disabled] {
  opacity: 0.6;
}
