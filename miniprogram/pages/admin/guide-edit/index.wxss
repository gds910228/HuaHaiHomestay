/* pages/admin/guide-edit/index.wxss */
.edit-container {
  min-height: 100vh;
  background: var(--bg-muted);
  padding-bottom: 120rpx;
}

.form-section {
  padding: 30rpx;
}

.form-item {
  background: var(--bg-surface);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: var(--bg-muted);
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  background: var(--bg-muted);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.picker-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background: var(--bg-muted);
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* ============ 标签 ============ */
.tag-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.tag-chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 28rpx;
  background: var(--brand-primary-soft);
  font-size: 24rpx;
  color: var(--brand-primary);
  line-height: 1.4;
  border: 2rpx solid transparent;
}

.tag-chip.selected {
  background: var(--brand-primary);
  color: var(--bg-surface);
}

.tag-chip.cloud {
  background: var(--bg-muted);
  color: var(--text-secondary);
  border: 2rpx solid var(--divider-color);
}

.tag-chip.cloud.selected {
  background: var(--brand-primary);
  color: var(--bg-surface);
  border-color: var(--brand-primary);
}

.tag-chip-text {
  font-size: 24rpx;
}

.tag-chip-close {
  margin-left: 10rpx;
  font-size: 28rpx;
  line-height: 1;
}

.tag-chip-count {
  margin-left: 6rpx;
  font-size: 20rpx;
  opacity: 0.7;
}

.tag-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tag-input {
  flex: 1;
}

.tag-add-btn {
  flex: none;
  padding: 0 28rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--brand-primary);
  color: var(--bg-surface);
  border-radius: 8rpx;
  font-size: 26rpx;
}

.tag-cloud-label {
  display: block;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* ============ 图片上传 ============ */
.image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.uploaded-images {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.upload-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--bg-surface);
  font-size: 24rpx;
}

/* 图片排序条 */
.reorder-bar {
  position: absolute;
  bottom: 6rpx;
  left: 6rpx;
  right: 6rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.reorder-btn {
  width: 40rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--bg-surface);
  font-size: 36rpx;
  line-height: 1;
  border-radius: 6rpx;
}

.reorder-btn:active {
  background: rgba(255, 255, 255, 0.18);
}

.reorder-btn.disabled {
  opacity: 0.3;
}

.reorder-pos {
  color: var(--bg-surface);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.5rpx;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--border-line);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-muted);
}

.upload-icon {
  font-size: 60rpx;
  color: var(--text-tertiary);
  line-height: 1;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ============ 富文本编辑器 ============ */
.editor-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 12rpx;
  background: var(--bg-muted);
  border-radius: 8rpx;
}

.tb-btn {
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 14rpx;
  line-height: 56rpx;
  text-align: center;
  background: var(--bg-surface);
  border: 2rpx solid var(--divider-color);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.tb-btn.active {
  background: var(--brand-primary);
  color: var(--bg-surface);
  border-color: var(--brand-primary);
}

.tb-btn.primary {
  background: var(--brand-primary);
  color: var(--bg-surface);
  border-color: var(--brand-primary);
}

.tb-btn.danger {
  color: var(--color-danger);
  border-color: var(--color-danger-soft);
}

.tb-bold { font-weight: bold; }
.tb-italic { font-style: italic; }
.tb-underline { text-decoration: underline; }

.rich-editor {
  width: 100%;
  min-height: 460rpx;
  padding: 20rpx;
  background: var(--bg-surface);
  border: 2rpx solid var(--divider-color);
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

/* ============ 底部按钮 ============ */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: var(--bg-surface);
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border: none;
}

.action-btn.primary {
  background: var(--brand-primary);
  color: var(--bg-surface);
}
