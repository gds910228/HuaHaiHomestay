/* pages/food/index.wxss */
.food-container {
  min-height: 100vh;
  background: var(--bg-gray);
  padding-bottom: 40rpx;
}

/* 骨架屏容器 */
.skeleton-wrapper {
  padding: 0 var(--space-lg);
}

/* 选项卡容器 */
.tabs-container {
  display: flex;
  justify-content: space-around;
  background: var(--bg-white);
  margin: var(--space-lg);
  border-radius: var(--radius-xl);
  padding: var(--space-xs);
  box-shadow: var(--shadow-md);
  animation: fadeInDown 0.5s var(--ease-out);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 12rpx;
  border-radius: var(--radius-md);
  transition: all var(--duration-normal) var(--ease-default);
  position: relative;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-item.active {
  background: linear-gradient(135deg, var(--accent-food) 0%, #FFA568 100%);
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.tab-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
  margin-bottom: 4rpx;
}

.tab-item.active .tab-name {
  color: #FFFFFF;
}

.tab-count {
  font-size: 22rpx;
  color: #999999;
}

.tab-item.active .tab-count {
  color: rgba(255, 255, 255, 0.9);
}

/* 选项卡内容区域 */
.tab-content-area {
  padding: 0 24rpx;
}

/* 页面标题 */
.page-header {
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, var(--accent-food) 0%, #FFA568 100%);
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 12rpx;
}

.loading-state {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #999999;
}

/* 区域分组 */
.area-section {
  margin-bottom: 32rpx;
}

/* 美食列表 */
.food-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.food-item {
  width: 100%;
}

/* 美食卡片 */
.food-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s;
}

.food-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

/* 有图片的卡片 */
.food-card.has-image {
  display: flex;
  flex-direction: column;
}

.food-card.has-image .food-image {
  width: 100%;
  height: 320rpx;
  object-fit: cover;
}

.food-card.has-image .food-info {
  padding: 24rpx;
}

.food-card.no-image .food-info {
  padding: 24rpx;
}

/* 无图片的卡片 */
.food-card.no-image {
  padding: 0;
}

/* 无图片时的占位区域 */
.food-no-image {
  width: 100%;
  height: 240rpx;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid var(--border-color-light);
}

.no-image-icon {
  font-size: 96rpx;
  margin-bottom: 12rpx;
  opacity: 0.6;
}

.no-image-text {
  font-size: 26rpx;
  color: #E65100;
  opacity: 0.8;
}

.food-info {
  display: flex;
  flex-direction: column;
}

.food-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.food-address {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
  line-height: 1.5;
  display: flex;
  align-items: flex-start;
}

.food-desc {
  font-size: 26rpx;
  color: #999999;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.food-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.food-tag {
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #E65100;
  font-weight: 500;
}

.food-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding-top: 16rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--border-color-light);
}

.food-card.no-image .food-actions {
  border-top: none;
  padding-top: 8rpx;
}

/* 导航按钮 */
.nav-btn {
  flex: 1;
  background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
  color: var(--text-white);
  border: none;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(46, 117, 255, 0.3);
  transition: all var(--duration-normal) var(--ease-default);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.nav-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.nav-btn text {
  display: inline-block;
}

/* 收藏按钮 */
.favorite-btn {
  flex: 1;
  background: var(--bg-gray);
  color: var(--text-secondary);
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  font-weight: 500;
  transition: all var(--duration-normal) var(--ease-default);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.favorite-btn:active {
  transform: scale(0.95);
}

.favorite-btn.favorited {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: var(--text-white);
  border-color: #FF6B6B;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.3);
}

.favorite-btn text {
  display: inline-block;
}

/* ===== 标签筛选条 ===== */
.tag-filter-bar {
  position: relative;
  background: #fff;
  margin: 0 24rpx 16rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  padding: 16rpx 20rpx 12rpx 20rpx;
  box-sizing: border-box;
}

/* 标签容器：默认两行，溢出隐藏；展开后显示全部 */
.tag-filter-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  overflow: hidden;
  /* 两行高度 ≈ chip 高度(56rpx) * 2 + gap(12rpx) */
  max-height: 124rpx;
  transition: max-height 0.25s ease;
}

.tag-filter-wrap.expanded {
  max-height: 2000rpx;
}

.tag-filter-item {
  flex: none;
  height: 56rpx;
  padding: 0 24rpx;
  line-height: 52rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 28rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.tag-filter-item.active {
  background: linear-gradient(135deg, #2E7DFF 0%, #4FC3F7 100%);
  color: #fff;
  border-color: #2E7DFF;
}

.tag-filter-toggle {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 8rpx;
  padding: 4rpx 0;
  font-size: 22rpx;
  color: #2E7DFF;
}
