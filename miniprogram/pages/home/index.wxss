/* pages/home/index.wxss */
.home-container {
  min-height: 100vh;
  background: var(--bg-gray);
  padding-bottom: 40rpx;
}

/* 顶部欢迎区 */
.header-banner {
  position: relative;
  background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-light) 100%);
  padding: 80rpx 32rpx 60rpx;
  overflow: hidden;
}

.banner-content {
  position: relative;
  z-index: 2;
}

.banner-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-white);
  margin-bottom: 12rpx;
}

.banner-subtitle {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.banner-wave {
  position: absolute;
  bottom: -1rpx;
  left: 0;
  right: 0;
  height: 60rpx;
  background: var(--bg-gray);
  border-radius: 50% 50% 0 0 / 100% 100% 0;
}

/* 分类卡片容器 */
.categories-container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.category-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  background: var(--bg-white);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  transition: transform var(--duration-normal) var(--ease-default);
}

.category-card:active {
  transform: translateY(-4rpx);
  box-shadow: var(--shadow-lg);
}

.card-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-white);
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.card-arrow {
  position: absolute;
  right: 32rpx;
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 300;
}
