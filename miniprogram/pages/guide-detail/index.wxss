/* pages/guide-detail/index.wxss */
.detail-container {
  min-height: 100vh;
  background: var(--bg-canvas);
  padding-bottom: 180rpx;
}

/* === 顶部图片 === */
.detail-images {
  position: relative;
  width: 100%;
  height: 540rpx;
  background: var(--bg-muted);
}

.images-swiper,
.detail-image {
  width: 100%;
  height: 100%;
}

.images-tint {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, transparent 60%, rgba(15, 56, 72, 0.35) 100%);
}

/* === 内容 sheet === */
.detail-content {
  background: var(--bg-surface);
  border-radius: var(--radius-2xl) var(--radius-2xl) 0 0;
  margin-top: -48rpx;
  position: relative;
  z-index: 2;
  padding: var(--space-xl);
  min-height: calc(100vh - 540rpx);
  box-shadow: 0 -8rpx 24rpx rgba(94, 72, 50, 0.05);
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: var(--space-md);
  gap: var(--space-md);
}

.header-left {
  flex: 1;
  min-width: 0;
}

.detail-category {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: var(--brand-primary-soft);
  color: var(--brand-primary);
  border-radius: var(--radius-pill);
  font-size: var(--font-xs);
  font-weight: 600;
  margin-bottom: var(--space-md);
  letter-spacing: 0.5rpx;
}

.detail-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
  letter-spacing: -1rpx;
}

/* 收藏 FAB */
.action-fab {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--bg-surface);
  border: 2rpx solid var(--border-line);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--duration-fast) var(--ease-out);
  flex-shrink: 0;
}

.action-fab:active {
  transform: scale(0.92);
}

.action-fab.fav-active {
  background: var(--brand-accent-soft);
  border-color: transparent;
  box-shadow: 0 4rpx 14rpx rgba(232, 145, 109, 0.32);
}

.fav-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 标签 */
.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: var(--space-md);
}

/* 统计 */
.detail-stats {
  display: flex;
  gap: var(--space-xl);
  padding: var(--space-md) 0;
  border-bottom: 2rpx solid var(--divider-color);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  width: 28rpx;
  height: 28rpx;
}

.stat-value {
  font-size: var(--font-sm);
  color: var(--text-secondary);
  font-weight: 500;
}

/* 分隔 */
.divider {
  height: 2rpx;
  background: transparent;
  margin: var(--space-md) 0;
}

/* === Body === */
.detail-body {
  margin-top: var(--space-md);
}

.body-section-eyebrow {
  font-size: var(--font-xs);
  letter-spacing: 4rpx;
  color: var(--text-tertiary);
  font-weight: 500;
  margin-bottom: var(--space-md);
}

.body-content {
  font-size: var(--font-base);
  color: var(--text-primary);
  line-height: 1.85;
  word-break: break-word;
}

/* rich-text 富文本图片 */
.body-content image,
.body-content img {
  max-width: 100% !important;
  height: auto !important;
  display: block;
  margin: var(--space-md) 0;
  border-radius: var(--radius-md);
}

/* === 实用信息 === */
.detail-info {
  margin-top: var(--space-2xl);
  padding-top: var(--space-lg);
  border-top: 2rpx solid var(--divider-color);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) 0;
  border-bottom: 2rpx solid var(--divider-color);
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: var(--font-base);
  color: var(--text-tertiary);
  letter-spacing: 0.5rpx;
}

.info-value {
  font-size: var(--font-base);
  color: var(--text-primary);
  font-weight: 600;
}

/* === 底部操作栏 === */
.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: var(--space-md);
  padding: var(--space-md) var(--space-lg);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background: rgba(251, 247, 240, 0.92);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 16rpx rgba(94, 72, 50, 0.06);
  z-index: 10;
}

.footer-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 96rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-lg);
  font-weight: 600;
}

.footer-btn-secondary {
  background: var(--bg-surface);
  color: var(--brand-primary);
  border: 2rpx solid var(--brand-primary);
}

.footer-btn-primary {
  background: var(--brand-primary);
  color: var(--text-white);
  box-shadow: var(--shadow-brand);
}

.footer-btn-icon {
  width: 32rpx;
  height: 32rpx;
}

/* === 加载 === */
.loading-container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
